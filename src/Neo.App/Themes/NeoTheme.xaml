<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Neo.App.Ui">

    

    <ResourceDictionary.ThemeDictionaries>

        
        <ResourceDictionary x:Key="Dark">

            
            <SolidColorBrush x:Key="NeoBackdrop" Color="#08080A" />
            <LinearGradientBrush x:Key="NeoWinBg" StartPoint="0,0" EndPoint="0.55,1">
                <GradientStop Color="#0E0E14" Offset="0" />
                <GradientStop Color="#08080A" Offset="0.55" />
                <GradientStop Color="#08080A" Offset="1" />
            </LinearGradientBrush>

            
            <SolidColorBrush x:Key="NeoPanel" Color="#1C1C22" />
            <SolidColorBrush x:Key="NeoSurface" Color="#2C2C2E" />
            <SolidColorBrush x:Key="NeoSurfaceHigh" Color="#35353A" />

            
            <SolidColorBrush x:Key="NeoRim" Color="#61FFFFFF" />

            
            <SolidColorBrush x:Key="NeoGlass" Color="#1C1C22" />
            <SolidColorBrush x:Key="NeoGlassStrong" Color="#35353A" />
            <!-- 弹层/菜单专用底色：不参与「玻璃透明度」缩放，保证任何档位下都清晰可读 -->
            <SolidColorBrush x:Key="NeoPopupSurface" Color="#F20F1218" />
            <SolidColorBrush x:Key="NeoGlass2" Color="#2C2C2E" />
            <SolidColorBrush x:Key="NeoGlass3" Color="#35353A" />
            <SolidColorBrush x:Key="NeoGlassBorder" Color="#21FFFFFF" />

            <SolidColorBrush x:Key="NeoOutline" Color="#21FFFFFF" />
            <SolidColorBrush x:Key="NeoHairline" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NeoHairline2" Color="#0DFFFFFF" />

            <SolidColorBrush x:Key="NeoText1" Color="#ECECEC" />
            <SolidColorBrush x:Key="NeoText2" Color="#9A9AA0" />
            <SolidColorBrush x:Key="NeoText3" Color="#6E6E76" />

            <SolidColorBrush x:Key="NeoAccent" Color="#5AA9FF" />
            <SolidColorBrush x:Key="NeoAccentSoft" Color="#245AA9FF" />
            <SolidColorBrush x:Key="NeoAccentLine" Color="#4D5AA9FF" />
            <SolidColorBrush x:Key="NeoOnAccent" Color="#06203A" />

            <SolidColorBrush x:Key="NeoGreen" Color="#43D17F" />
            <SolidColorBrush x:Key="NeoGreenSoft" Color="#2443D17F" />
            <SolidColorBrush x:Key="NeoYellow" Color="#F0A93B" />
            <SolidColorBrush x:Key="NeoYellowSoft" Color="#24F0A93B" />
            <SolidColorBrush x:Key="NeoRed" Color="#FF6B6B" />
            <SolidColorBrush x:Key="NeoRedSoft" Color="#24FF6B6B" />
            <SolidColorBrush x:Key="NeoOrange" Color="#F0A93B" />

            <SolidColorBrush x:Key="NeoTrack" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NeoChipBg" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NeoHover" Color="#0FFFFFFF" />

            
            <SolidColorBrush x:Key="NeoCell" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="NeoCellOn" Color="#5AA9FF" />

            
            <Color x:Key="NeoBarFrom">#5AA9FF</Color>
            <Color x:Key="NeoBarTo">#7CC4FF</Color>

            
            <SolidColorBrush x:Key="NeoKnobStroke" Color="#22000000" />

            
            <SolidColorBrush x:Key="RingBlue" Color="#7CC4FF" />
            <SolidColorBrush x:Key="RingBlueSoft" Color="#247CC4FF" />
            <SolidColorBrush x:Key="RingBlueGlow" Color="#557CC4FF" />

            
            <LinearGradientBrush x:Key="NeoCoolSurface" StartPoint="0.4,0" EndPoint="0.6,1">
                <GradientStop Color="#26A8C4E8" Offset="0" />
                <GradientStop Color="#1CA8C4E8" Offset="0.55" />
                <GradientStop Color="#14A8C4E8" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="NeoCoolBorder" Color="#3BB0CCF0" />
            <SolidColorBrush x:Key="NeoCoolInsetBottom" Color="#1E96B4DC" />

            <LinearGradientBrush x:Key="NeoCoolTopLine" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#00D2E6FF" Offset="0" />
                <GradientStop Color="#73D2E6FF" Offset="0.20" />
                <GradientStop Color="#73D2E6FF" Offset="0.80" />
                <GradientStop Color="#00D2E6FF" Offset="1" />
            </LinearGradientBrush>

        </ResourceDictionary>

        
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="NeoBackdrop" Color="#F2F2F4" />
            <LinearGradientBrush x:Key="NeoWinBg" StartPoint="0,0" EndPoint="0.55,1">
                <GradientStop Color="#EAEAEF" Offset="0" />
                <GradientStop Color="#F2F2F4" Offset="0.55" />
                <GradientStop Color="#F2F2F4" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="NeoPanel" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeoSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeoSurfaceHigh" Color="#F7F7F9" />

            
            <SolidColorBrush x:Key="NeoRim" Color="#D9FFFFFF" />

            <SolidColorBrush x:Key="NeoGlass" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeoGlassStrong" Color="#FFFFFF" />
            <!-- 弹层/菜单底色：固定高不透明，避免跟随玻璃滑杆变得不可读 -->
            <SolidColorBrush x:Key="NeoPopupSurface" Color="#FCFFFFFF" />
            <SolidColorBrush x:Key="NeoGlass2" Color="#F7F7F9" />
            <SolidColorBrush x:Key="NeoGlass3" Color="#F7F7F9" />
            <SolidColorBrush x:Key="NeoGlassBorder" Color="#A6FFFFFF" />

            <SolidColorBrush x:Key="NeoOutline" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="NeoHairline" Color="#14121616" />
            <SolidColorBrush x:Key="NeoHairline2" Color="#0E121616" />

            <SolidColorBrush x:Key="NeoText1" Color="#121216" />
            <SolidColorBrush x:Key="NeoText2" Color="#5E5E66" />
            <SolidColorBrush x:Key="NeoText3" Color="#8E8E96" />

            <SolidColorBrush x:Key="NeoAccent" Color="#2563EB" />
            <SolidColorBrush x:Key="NeoAccentSoft" Color="#1A2563EB" />
            <SolidColorBrush x:Key="NeoAccentLine" Color="#382563EB" />
            <SolidColorBrush x:Key="NeoOnAccent" Color="#FFFFFF" />

            <SolidColorBrush x:Key="NeoGreen" Color="#16A34A" />
            <SolidColorBrush x:Key="NeoGreenSoft" Color="#1A16A34A" />
            <SolidColorBrush x:Key="NeoYellow" Color="#D97706" />
            <SolidColorBrush x:Key="NeoYellowSoft" Color="#1CD97706" />
            <SolidColorBrush x:Key="NeoRed" Color="#DC2626" />
            <SolidColorBrush x:Key="NeoRedSoft" Color="#1ADC2626" />
            <SolidColorBrush x:Key="NeoOrange" Color="#D97706" />

            <SolidColorBrush x:Key="NeoTrack" Color="#12121616" />
            <SolidColorBrush x:Key="NeoChipBg" Color="#0E121616" />
            <SolidColorBrush x:Key="NeoHover" Color="#0C121616" />

            <SolidColorBrush x:Key="NeoCell" Color="#0E121616" />
            <SolidColorBrush x:Key="NeoCellOn" Color="#2563EB" />

            <Color x:Key="NeoBarFrom">#2563EB</Color>
            <Color x:Key="NeoBarTo">#7CC4FF</Color>

            <SolidColorBrush x:Key="NeoKnobStroke" Color="#22000000" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="NeoFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="NeoMonoFont">Cascadia Mono, Consolas</FontFamily>

    
    <CornerRadius x:Key="NeoPanelRadius">26</CornerRadius>
    <CornerRadius x:Key="NeoRowRadius">16</CornerRadius>
    <CornerRadius x:Key="NeoPillRadius">10</CornerRadius>
    
    <Thickness x:Key="NeoRimThickness">2</Thickness>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NeoFont}" />
    </Style>

    
    <Style x:Key="NeoGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NeoPanel}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoRim}" />
        <Setter Property="BorderThickness" Value="{StaticResource NeoRimThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource NeoPanelRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    
    <Style x:Key="NeoCard" TargetType="Border" BasedOn="{StaticResource NeoGlassPanel}" />
    <Style x:Key="NeoCardTight" TargetType="Border" BasedOn="{StaticResource NeoGlassPanel}">
        <Setter Property="Padding" Value="14" />
    </Style>

    
    <Style x:Key="NeoInset" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NeoSurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NeoRowRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="NeoPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource NeoPillRadius}" />
        <Setter Property="Padding" Value="8,2.5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    
    
    <Style TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        
        <Setter Property="ManipulationMode" Value="System,TranslateX" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    
                    <Grid x:Name="SwitchRoot" Width="44" Height="26"
                          Background="Transparent">
                        <Border x:Name="Track" CornerRadius="13"
                                Background="{ThemeResource NeoTrack}"
                                BorderBrush="{ThemeResource NeoHairline}"
                                BorderThickness="1" />
                        
                        <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#FFFFFFFF"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        
                        <Thumb x:Name="SwitchThumb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               AutomationProperties.AccessibilityView="Raw">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <VisualStateManager.VisualStateGroups>
                            
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualState x:Name="Off">
                                    <Storyboard>
                                        
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01"
                                                                    Value="{ThemeResource NeoTrack}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                       Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="1" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01"
                                                                    Value="{ThemeResource NeoAccent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track"
                                                                       Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="Foreground" Value="{ThemeResource NeoText2}" />
    </Style>

    
    <Style TargetType="ui:CoolGlassCard">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        
        <Setter Property="Padding" Value="20,18,20,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:CoolGlassCard">
                    <Grid>
                        <Border Background="{ThemeResource NeoCoolSurface}"
                                BorderBrush="{ThemeResource NeoCoolBorder}"
                                BorderThickness="1"
                                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Border CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="1,1,0,0"
                                BorderBrush="{ThemeResource NeoCoolTopLine}"
                                IsHitTestVisible="False" />

                        <Border CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource NeoCoolInsetBottom}"
                                IsHitTestVisible="False" />

                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

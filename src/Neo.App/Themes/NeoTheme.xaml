            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
            <ImageBrush x:Key="NeoCardSurface" ImageSource="ms-appx:///Assets/surface-soft.png" Stretch="Fill" />

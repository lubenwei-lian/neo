            <SolidColorBrush x:Key="NeoPopupSurface" Color="#FF242429" />
            <SolidColorBrush x:Key="NeoGlass2" Color="#2C2C2E" />
            <SolidColorBrush x:Key="NeoGlass3" Color="#35353A" />
            <SolidColorBrush x:Key="NeoGlassBorder" Color="#21FFFFFF" />

            <SolidColorBrush x:Key="NeoOutline" Color="#21FFFFFF" />
            <SolidColorBrush x:Key="NeoHairline" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NeoHairline2" Color="#0DFFFFFF" />

            <SolidColorBrush x:Key="NeoText1" Color="#ECECEC" />
            <SolidColorBrush x:Key="NeoText2" Color="#9A9AA0" />
            <SolidColorBrush x:Key="NeoText3" Color="#969BA5" />

            <SolidColorBrush x:Key="NeoAccent" Color="#5AA9FF" />
            <SolidColorBrush x:Key="NeoAccentSoft" Color="#245AA9FF" />
            <SolidColorBrush x:Key="NeoAccentLine" Color="#4D5AA9FF" />
            <SolidColorBrush x:Key="NeoOnAccent" Color="#06203A" />

            <SolidColorBrush x:Key="NeoGreen" Color="#43D17F" />
            <SolidColorBrush x:Key="NeoGreenSoft" Color="#2443D17F" />
            <SolidColorBrush x:Key="NeoYellow" Color="#F0A93B" />
            <SolidColorBrush x:Key="NeoYellowSoft" Color="#24F0A93B" />
            <SolidColorBrush x:Key="NeoRed" Color="#FF6B6B" />
            <SolidColorBrush x:Key="NeoRedSoft" Color="#24FF6B6B" />
            <SolidColorBrush x:Key="NeoOrange" Color="#F0A93B" />

            <SolidColorBrush x:Key="NeoTrack" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NeoChipBg" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NeoHover" Color="#0FFFFFFF" />

            
            <SolidColorBrush x:Key="NeoCell" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="NeoCellOn" Color="#5AA9FF" />

            
            <Color x:Key="NeoBarFrom">#5AA9FF</Color>
            <Color x:Key="NeoBarTo">#7CC4FF</Color>

            
            <SolidColorBrush x:Key="NeoKnobStroke" Color="#22000000" />

            
            <SolidColorBrush x:Key="RingBlue" Color="#7CC4FF" />
            <SolidColorBrush x:Key="RingBlueSoft" Color="#247CC4FF" />
            <SolidColorBrush x:Key="RingBlueGlow" Color="#557CC4FF" />

            
            <LinearGradientBrush x:Key="NeoCoolSurface" StartPoint="0.4,0" EndPoint="0.6,1">
                <GradientStop Color="#26A8C4E8" Offset="0" />
                <GradientStop Color="#1CA8C4E8" Offset="0.55" />
                <GradientStop Color="#14A8C4E8" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="NeoCoolBorder" Color="#3BB0CCF0" />
            <SolidColorBrush x:Key="NeoCoolInsetBottom" Color="#1E96B4DC" />

            <LinearGradientBrush x:Key="NeoCoolTopLine" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#00D2E6FF" Offset="0" />
                <GradientStop Color="#73D2E6FF" Offset="0.20" />
                <GradientStop Color="#73D2E6FF" Offset="0.80" />
                <GradientStop Color="#00D2E6FF" Offset="1" />
            </LinearGradientBrush>

        </ResourceDictionary>

        
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NeoSearchSurface" Color="#F7F7F9" />
            <SolidColorBrush x:Key="NeoControlSurface" Color="#F7F7F9" />
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#B35AA9FF" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
            <LinearGradientBrush x:Key="NeoCardSurface" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F7F8FC" Offset="1" />
            </LinearGradientBrush>


            <SolidColorBrush x:Key="NeoBackdrop" Color="#F2F2F4" />
            <LinearGradientBrush x:Key="NeoWinBg" StartPoint="0,0" EndPoint="0.55,1">
                <GradientStop Color="#EAEAEF" Offset="0" />
                <GradientStop Color="#F2F2F4" Offset="0.55" />
                <GradientStop Color="#F2F2F4" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="NeoPanel" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeoSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeoSurfaceHigh" Color="#F7F7F9" />

            
            <SolidColorBrush x:Key="NeoRim" Color="#D9FFFFFF" />

            <SolidColorBrush x:Key="NeoGlass" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeoGlassStrong" Color="#FFFFFF" />
            <!-- 弹层/菜单底色：固定高不透明，避免跟随玻璃滑杆变得不可读 -->
            <SolidColorBrush x:Key="NeoPopupSurface" Color="#FCFFFFFF" />
            <SolidColorBrush x:Key="NeoGlass2" Color="#F7F7F9" />
            <SolidColorBrush x:Key="NeoGlass3" Color="#F7F7F9" />
            <SolidColorBrush x:Key="NeoGlassBorder" Color="#A6FFFFFF" />

            <SolidColorBrush x:Key="NeoOutline" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="NeoHairline" Color="#14121616" />
            <SolidColorBrush x:Key="NeoHairline2" Color="#0E121616" />

            <SolidColorBrush x:Key="NeoText1" Color="#121216" />
            <SolidColorBrush x:Key="NeoText2" Color="#5E5E66" />
            <SolidColorBrush x:Key="NeoText3" Color="#8E8E96" />

            <SolidColorBrush x:Key="NeoAccent" Color="#2563EB" />
            <SolidColorBrush x:Key="NeoAccentSoft" Color="#1A2563EB" />
            <SolidColorBrush x:Key="NeoAccentLine" Color="#382563EB" />
            <SolidColorBrush x:Key="NeoOnAccent" Color="#FFFFFF" />

            <SolidColorBrush x:Key="NeoGreen" Color="#16A34A" />
            <SolidColorBrush x:Key="NeoGreenSoft" Color="#1A16A34A" />
            <SolidColorBrush x:Key="NeoYellow" Color="#D97706" />
            <SolidColorBrush x:Key="NeoYellowSoft" Color="#1CD97706" />
            <SolidColorBrush x:Key="NeoRed" Color="#DC2626" />
            <SolidColorBrush x:Key="NeoRedSoft" Color="#1ADC2626" />
            <SolidColorBrush x:Key="NeoOrange" Color="#D97706" />

            <SolidColorBrush x:Key="NeoTrack" Color="#12121616" />
            <SolidColorBrush x:Key="NeoChipBg" Color="#0E121616" />
            <SolidColorBrush x:Key="NeoHover" Color="#0C121616" />

            <SolidColorBrush x:Key="NeoCell" Color="#0E121616" />
            <SolidColorBrush x:Key="NeoCellOn" Color="#2563EB" />

            <Color x:Key="NeoBarFrom">#2563EB</Color>
            <Color x:Key="NeoBarTo">#7CC4FF</Color>

            <!-- Keep all surfaces resolvable when Windows switches themes at runtime. -->
            <LinearGradientBrush x:Key="NeoNodeSurface" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F7F8FC" Offset="1"/></LinearGradientBrush>
            <LinearGradientBrush x:Key="NeoNodeSelected" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#242563EB" Offset="0"/><GradientStop Color="#142563EB" Offset="1"/></LinearGradientBrush>
            <LinearGradientBrush x:Key="NeoNodeHover" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0E2563EB" Offset="0"/><GradientStop Color="#072563EB" Offset="1"/></LinearGradientBrush>
            <SolidColorBrush x:Key="RingBlue" Color="#2563EB" />
            <SolidColorBrush x:Key="RingBlueSoft" Color="#242563EB" />
            <SolidColorBrush x:Key="RingBlueGlow" Color="#552563EB" />
            <LinearGradientBrush x:Key="NeoCoolSurface" StartPoint="0.4,0" EndPoint="0.6,1">
                <GradientStop Color="#142563EB" Offset="0"/><GradientStop Color="#0E2563EB" Offset="0.55"/><GradientStop Color="#082563EB" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="NeoCoolBorder" Color="#382563EB" />
            <SolidColorBrush x:Key="NeoCoolInsetBottom" Color="#142563EB" />
            <LinearGradientBrush x:Key="NeoCoolTopLine" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#002563EB" Offset="0"/><GradientStop Color="#382563EB" Offset="0.20"/><GradientStop Color="#382563EB" Offset="0.80"/><GradientStop Color="#002563EB" Offset="1"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="NeoKnobStroke" Color="#22000000" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="NeoFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="NeoMonoFont">Cascadia Mono, Consolas</FontFamily>

    
    <CornerRadius x:Key="NeoPanelRadius">26</CornerRadius>
    <CornerRadius x:Key="NeoRowRadius">20</CornerRadius>
    <CornerRadius x:Key="NeoPillRadius">14</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">20</CornerRadius>
    
    <Thickness x:Key="NeoRimThickness">1</Thickness>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NeoFont}" />
    </Style>

    
    <Style x:Key="NeoGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NeoPanel}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoRim}" />
        <Setter Property="BorderThickness" Value="{StaticResource NeoRimThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource NeoPanelRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    
    <Style x:Key="NeoCard" TargetType="Border" BasedOn="{StaticResource NeoGlassPanel}">
        <Setter Property="ui:SurfaceEdge.Enabled" Value="True"/>
        <Setter Property="Background" Value="{ThemeResource NeoCardSurface}" />
    </Style>
    <Style x:Key="NeoCardTight" TargetType="Border" BasedOn="{StaticResource NeoCard}">
        <Setter Property="Padding" Value="14" />
    </Style>

    
    <Style x:Key="NeoInset" TargetType="Border">
        <Setter Property="ui:SurfaceEdge.Enabled" Value="True"/>
        <Setter Property="Background" Value="{ThemeResource NeoCardSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NeoRowRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="NeoPill" TargetType="Border">
        <Setter Property="ui:PillShape.Enabled" Value="True" />
        <Setter Property="CornerRadius" Value="{StaticResource NeoPillRadius}" />
        <Setter Property="Padding" Value="8,2.5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    
    
    <!-- Source switch-d: geometry never follows AdaptiveText.Scale. -->
    <Style TargetType="ToggleSwitch">
        <Setter Property="ui:SwitchMotion.Enabled" Value="True" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="ManipulationMode" Value="System,TranslateX" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid x:Name="SwitchRoot" Width="44" Height="26" Background="Transparent" CornerRadius="13">
                        <Border x:Name="Track" CornerRadius="13" Background="{ThemeResource NeoTrack}"
                                BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" />
                        <Ellipse x:Name="AccentReveal" Width="20" Height="20" Fill="{ThemeResource NeoAccent}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                 IsHitTestVisible="False" />
                        <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#FFFFFFFF"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                 IsHitTestVisible="False" />
                        <Thumb x:Name="SwitchThumb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               AutomationProperties.AccessibilityView="Raw">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SwitchRoot.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <!-- Native ToggleSwitch owns state; SwitchMotion owns finite transforms. -->
                            <VisualStateGroup x:Name="ToggleStates"><VisualState x:Name="Off" /><VisualState x:Name="On" /><VisualState x:Name="Dragging" /></VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Other native menus share the same rounded surface as PopupList. -->
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{ThemeResource NeoPopupSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="MenuFlyoutItem">
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style TargetType="ToggleMenuFlyoutItem">
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style TargetType="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource NeoPopupSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="Foreground" Value="{ThemeResource NeoText2}" />
    </Style>

    
    <Style TargetType="ui:CoolGlassCard">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        
        <Setter Property="Padding" Value="20,18,20,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:CoolGlassCard">
                    <Grid>
                        <Border ui:SurfaceEdge.Enabled="True" Background="{ThemeResource NeoCardSurface}"
                                BorderBrush="{ThemeResource NeoRim}"
                                BorderThickness="1"
                                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Border CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="1,1,0,0"
                                BorderBrush="{ThemeResource NeoHairline}"
                                IsHitTestVisible="False" />

                        <Border CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource NeoHairline2}"
                                IsHitTestVisible="False" />

                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Explicit pill chrome: no default WinUI press-scale or hover fill can
         override the prototype selection colors or stretch the content. -->
    <Style x:Key="NeoPillButton" TargetType="Button">
        <Setter Property="ui:PillShape.Enabled" Value="True" />
        <Setter Property="Background" Value="{ThemeResource NeoTrack}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="PillChrome" Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="PillHover" Background="{ThemeResource NeoHover}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16" /></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"><VisualState.Setters><Setter Target="PillHover.Opacity" Value="0" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="PillHover.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="PillHover.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="PillChrome.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Dedicated modal shell: the body owns the ONLY ScrollViewer. There is
         no WinUI entrance zoom and no outer content scroller to steal its wheel. -->
    <Style x:Key="NeoCapsuleDialog" TargetType="ContentDialog">
        <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        <Setter Property="Background" Value="{ThemeResource NeoPopupSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NeoRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentDialog">
                    <Border x:Name="Container">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DialogShowingStates">
                                <VisualState x:Name="DialogHidden" />
                                <VisualState x:Name="DialogShowing"><VisualState.Setters>
                                    <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                    <Setter Target="BackgroundElement.TabFocusNavigation" Value="Cycle" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="DialogShowingWithoutSmokeLayer"><VisualState.Setters>
                                    <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                </VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DialogSizingStates"><VisualState x:Name="DefaultDialogSizing" /><VisualState x:Name="FullDialogSizing" /></VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="LayoutRoot" Visibility="Collapsed">
                            <Rectangle x:Name="SmokeLayerBackground" Fill="#94000000" />
                            <Canvas x:Name="MorphLayer" IsHitTestVisible="False" />
                            <Border x:Name="BackgroundElement" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="{ThemeResource ContentDialogMaxWidth}" MaxHeight="{ThemeResource ContentDialogMaxHeight}">
                                <Grid>
                                    <Border x:Name="RestChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26" Opacity="0" />
                                    <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Opacity="0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Neo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Neo.App.Pages"
    xmlns:tb="using:H.NotifyIcon"
    Title="neo">

    
    <Grid x:Name="Root" Background="{ThemeResource NeoWinBg}">

        <Grid.Resources>
            <Style x:Key="NavItemButton" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource NeoText2}" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource NeoText2}" />
            </Style>
            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        


        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="neo" />

        <Grid x:Name="Shell">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBarRoot" Padding="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border x:Name="BrandMarkBox" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center" />
                        <TextBlock Text="neo" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="12" Fill="{ThemeResource NeoHairline}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PageTitleText" Text="连接" FontSize="11.5"
                                   Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="TopRightTools" Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Padding="14,10,14,14" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                
                <Border Grid.Column="0" Style="{StaticResource NeoCardTight}" Padding="10">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                            <Grid>
                                <Button x:Name="NavConn" Tag="conn" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="连接" />
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="15" />
                                        <TextBlock Text="连接" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse x:Name="NavConnDot" Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{ThemeResource NeoText3}" />
                                        <TextBlock x:Name="NavConnStatus" Text="未连接" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource NeoText3}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavNodes" Tag="nodes" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="节点" />
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="15" />
                                        <TextBlock Text="节点" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="NavNodesCount" Grid.Column="1" Text="0" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NeoText3}" />
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavSubs" Tag="subs" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="订阅" />
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="15" />
                                        <TextBlock Text="订阅" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="NavSubsCount" Grid.Column="1" Text="0" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NeoText3}" />
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavSettings" Tag="settings" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="设置" />
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15" />
                                        <TextBlock Text="设置" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NeoText3}" />
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavRule" Tag="rule" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="规则" />
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="15" />
                                        <TextBlock Text="规则" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="规则集" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NeoText3}" />
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavLog" Tag="log" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="日志" />
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9D5;" Style="{StaticResource Glyph}" FontSize="15" />
                                        <TextBlock Text="日志" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="实时" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NeoText3}" />
                                </Grid>
                            </Grid>
                        </StackPanel>

                    
                    <Border Grid.Row="2" Style="{StaticResource NeoInset}" VerticalAlignment="Bottom">
                        <StackPanel Spacing="6">
                            <TextBlock Text="今日已用" FontSize="10.5" Foreground="{ThemeResource NeoText2}" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="UsageTodayText" Text="0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeoText1}" />
                                <TextBlock x:Name="UsageTodayUnit" Text="B" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="累计" FontSize="10.5" Foreground="{ThemeResource NeoText2}" />
                                <TextBlock x:Name="UsageTotalText" Text="0 B" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource NeoText2}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource NeoInset}" Margin="0,8,0,0">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource Glyph}" FontSize="14"
                                               Foreground="{ThemeResource NeoText2}" />
                                    <TextBlock Text="内核" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border x:Name="CoreStatusBadge" Style="{StaticResource NeoPill}" HorizontalAlignment="Right"
                                        Background="{ThemeResource NeoGreenSoft}">
                                    <TextBlock x:Name="CoreStatusText" Text="未运行" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{ThemeResource NeoGreen}" />
                                </Border>
                            </Grid>
                            <Grid>
                                <TextBlock Text="内存占用" FontSize="10.5" Foreground="{ThemeResource NeoText2}" />
                                <TextBlock x:Name="CoreMemText" Text="—" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource NeoText1}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="版本" FontSize="10.5" Foreground="{ThemeResource NeoText2}" />
                                <TextBlock x:Name="SideCoreVersion" Text="xray —" FontSize="11.5" FontWeight="Medium" HorizontalAlignment="Right"
                                           FontFamily="{ThemeResource NeoMonoFont}"
                                           Foreground="{ThemeResource NeoText1}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 安全模式横幅：上次启动检测到内核异常（自动关闭 TUN/固定出口）时常驻显示，
                         直到用户「知道了」或恢复设置。对标成熟客户端的状态提示，而不是一闪而过的气泡。 -->
                    <Border x:Name="SafeModeBanner" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,10"
                            Background="{ThemeResource NeoGlass}" BorderBrush="{ThemeResource NeoGlassBorder}"
                            BorderThickness="1" CornerRadius="9" Padding="12,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock x:Name="SafeModeText" Text="" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="查看日志" Style="{StaticResource PillButton}" Click="OnSafeModeLogClick" />
                                <Button Content="知道了" Style="{StaticResource PillButton}" Click="OnSafeModeDismissClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ★ 页面惰性创建（省内存）：此处只留承载格；页面在首次导航时由
                         MainWindow.EnsurePage(...) 创建并加入，之后缓存复用、不销毁不重建。 -->
                    <Grid x:Name="PageHost" Grid.Row="1" />

                    <Border x:Name="StatusToast" Grid.Row="1" Style="{StaticResource NeoPill}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,0,2,0" Visibility="Collapsed"
                            Background="{ThemeResource NeoGlass}"
                            BorderBrush="{ThemeResource NeoGlassBorder}" Padding="11,6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource NeoText3}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusMain" Text="" FontSize="11.5" Foreground="{ThemeResource NeoText2}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Canvas x:Name="RippleLayer" IsHitTestVisible="False" />
    </Grid>
</Window>

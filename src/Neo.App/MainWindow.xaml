<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Neo.App.Ui" xmlns:pages="using:Neo.App.Pages" xmlns:tb="using:H.NotifyIcon" x:Class="Neo.App.MainWindow" Title="neo">

    
    <Grid x:Name="Root" Background="{ThemeResource NeoWinBg}" SizeChanged="OnRootLayoutSizeChanged">

        <Grid.Resources>
            <Style x:Key="NavItemButton" TargetType="Button" BasedOn="{StaticResource NeoPillButton}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,9"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Foreground" Value="{ThemeResource NeoText2}"/>
                <Setter Property="ui:AdaptiveText.BaseSize" Value="12.5"/>
            <Setter Property="ui:AdaptiveText.BaseHeight" Value="34"/></Style>
            <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource NeoPillButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9,3"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ui:AdaptiveText.BaseSize" Value="11"/>
                <Setter Property="Foreground" Value="{ThemeResource NeoText2}"/>
            <Setter Property="Background" Value="{ThemeResource NeoTrack}"/></Style>
            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        


        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="neo"/>

        <Grid x:Name="Shell">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBarRoot" Padding="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image x:Name="BrandMarkBox" Width="20" Height="20"
                               Source="ms-appx:///Assets/neo-mark.png" Stretch="Uniform"
                               VerticalAlignment="Center" AutomationProperties.Name="Neo"/>
                        <TextBlock Text="neo" ui:AdaptiveText.BaseSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="12" Fill="{ThemeResource NeoHairline}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageTitleText" Text="连接" ui:AdaptiveText.BaseSize="11.5" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="TopRightTools" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ShellBody" Grid.Row="1" Padding="14,10,14,14" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                
                <Border Grid.Column="0" Style="{StaticResource NeoCardTight}" Padding="10" CornerRadius="30">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                            <Grid>
                                <Button x:Name="NavConn" Tag="conn" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="连接"/>
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="15"/>
                                        <TextBlock Text="连接" ui:AdaptiveText.BaseSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse x:Name="NavConnDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource NeoText3}"/>
                                        <TextBlock x:Name="NavConnStatus" Text="未连接" ui:AdaptiveText.BaseSize="10" VerticalAlignment="Center" Foreground="{ThemeResource NeoText3}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavNodes" Tag="nodes" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="节点"/>
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="15"/>
                                        <TextBlock Text="节点" ui:AdaptiveText.BaseSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NavNodesCount" Grid.Column="1" Text="0" ui:AdaptiveText.BaseSize="10" VerticalAlignment="Center" Foreground="{ThemeResource NeoText3}"/>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavSubs" Tag="subs" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="订阅"/>
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="15"/>
                                        <TextBlock Text="订阅" ui:AdaptiveText.BaseSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NavSubsCount" Grid.Column="1" Text="0" ui:AdaptiveText.BaseSize="10" VerticalAlignment="Center" Foreground="{ThemeResource NeoText3}"/>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavSubLog" Tag="sublog" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="订阅日志"/>
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="15"/>
                                        <TextBlock Text="订阅日志" ui:AdaptiveText.BaseSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="链路" ui:AdaptiveText.BaseSize="10" VerticalAlignment="Center" Foreground="{ThemeResource NeoText3}"/>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Button x:Name="NavLog" Tag="log" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="日志"/>
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="15"/>
                                        <TextBlock Text="日志" ui:AdaptiveText.BaseSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="实时" ui:AdaptiveText.BaseSize="10" VerticalAlignment="Center" Foreground="{ThemeResource NeoText3}"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                    
                    <Border Grid.Row="2" Style="{StaticResource NeoInset}" VerticalAlignment="Bottom" x:Name="SidebarUsageCard">
                        <Grid RowSpacing="5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="今日已用" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5"><TextBlock x:Name="UsageTodayText" Text="0" ui:AdaptiveText.BaseSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UsageTodayUnit" Text="B" ui:AdaptiveText.BaseSize="10.5" VerticalAlignment="Bottom" Foreground="{ThemeResource NeoText2}"/></StackPanel>
                            <Grid x:Name="SidebarUsageDetail" Grid.Row="2"><TextBlock Text="累计" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}"/><TextBlock x:Name="UsageTotalText" Text="0 B" ui:AdaptiveText.BaseSize="10.5" HorizontalAlignment="Right" Foreground="{ThemeResource NeoText2}"/></Grid>
                        </Grid></Border>

                    <Grid Grid.Row="4">
                                <Button x:Name="NavSettings" Tag="settings" Style="{StaticResource NavItemButton}" Click="OnNavClick" AutomationProperties.Name="设置"/>
                                <Grid IsHitTestVisible="False" Margin="10,9,10,9" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="15"/>
                                        <TextBlock Text="设置" ui:AdaptiveText.BaseSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsCaret" Grid.Column="1" Text="" FontFamily="Segoe Fluent Icons" ui:AdaptiveText.BaseSize="10" VerticalAlignment="Center" Foreground="{ThemeResource NeoText3}"/>
                                </Grid>
                            </Grid>
                            <Grid x:Name="SettingsReveal" Visibility="Collapsed" Grid.Row="3" Height="0" IsHitTestVisible="False"><Grid x:Name="SettingsRevealContent" VerticalAlignment="Top" RowSpacing="6" ColumnSpacing="6" Padding="9" CornerRadius="22" Background="{ThemeResource NeoCardSurface}" BorderBrush="{ThemeResource NeoRim}" BorderThickness="1">
<Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<TextBlock Grid.ColumnSpan="2" Text="设置分组" Margin="6,0,0,0" ui:AdaptiveText.BaseSize="10" Foreground="{ThemeResource NeoText3}"/><Button Grid.Row="1" Tag="general" Content="通用" Click="OnSettingsGroupClick" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="9,0" MinHeight="0"/>
<Button Grid.Row="1" Grid.Column="1" Tag="network" Content="网络" Click="OnSettingsGroupClick" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="9,0" MinHeight="0"/>
<Button Grid.Row="2" Tag="kernel" Content="内核" Click="OnSettingsGroupClick" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="9,0" MinHeight="0"/>
<Button Grid.Row="2" Grid.Column="1" Tag="routing" Content="分流" Click="OnSettingsGroupClick" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="9,0" MinHeight="0"/>
<Button Grid.Row="3" Tag="logs" Content="日志" Click="OnSettingsGroupClick" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="9,0" MinHeight="0"/>
<Button Grid.Row="3" Grid.Column="1" Tag="about" Content="关于" Click="OnSettingsGroupClick" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="9,0" MinHeight="0"/>
</Grid></Grid></Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 安全模式横幅：上次启动检测到内核异常（自动关闭 TUN/固定出口）时常驻显示，
                         直到用户「知道了」或恢复设置。对标成熟客户端的状态提示，而不是一闪而过的气泡。 -->
                    <Border x:Name="SafeModeBanner" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,10" Background="{ThemeResource NeoGlass}" BorderBrush="{ThemeResource NeoGlassBorder}" BorderThickness="1" CornerRadius="9" Padding="12,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="" ui:AdaptiveText.BaseSize="13" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock x:Name="SafeModeText" Text="" ui:AdaptiveText.BaseSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="查看日志" Style="{StaticResource PillButton}" Click="OnSafeModeLogClick"/>
                                <Button Content="知道了" Style="{StaticResource PillButton}" Click="OnSafeModeDismissClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ★ 页面惰性创建（省内存）：此处只留承载格；页面在首次导航时由
                         MainWindow.EnsurePage(...) 创建并加入，之后缓存复用、不销毁不重建。 -->
                    <Grid x:Name="PageHost" Grid.Row="2"/>

                    <!-- Notifications own a layout row: long messages wrap within the content width
                         and never paint over a page heading or its controls. -->
                    <Border x:Name="StatusToast" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,10" Visibility="Collapsed" Background="{ThemeResource NeoGlass}" BorderBrush="{ThemeResource NeoGlassBorder}" BorderThickness="1" CornerRadius="9" Padding="11,8">
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource NeoText3}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                            <TextBlock x:Name="StatusMain" Grid.Column="1" Text="" ui:AdaptiveText.BaseSize="11.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Canvas x:Name="RippleLayer" IsHitTestVisible="False"/>
    </Grid>
</Window>

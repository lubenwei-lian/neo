<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Neo.App.Ui" x:Class="Neo.App.Pages.ConnectionPage" SizeChanged="OnPageSizeChanged">

    

    <UserControl.Resources>
        <Style x:Key="HomeCardHead" TargetType="TextBlock">
            <Setter Property="ui:AdaptiveText.BaseSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{ThemeResource NeoText2}"/>
        </Style>
        <Style x:Key="HomeCardHint" TargetType="TextBlock">
            <Setter Property="ui:AdaptiveText.BaseSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource NeoText3}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HomeLineKey" TargetType="TextBlock">
            <Setter Property="ui:AdaptiveText.BaseSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{ThemeResource NeoText2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HomeLineVal" TargetType="TextBlock">
            <Setter Property="ui:AdaptiveText.BaseSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HomeMetaChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{ThemeResource NeoTrack}"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HomeSectionLabel" TargetType="TextBlock">
            <Setter Property="ui:AdaptiveText.BaseSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{ThemeResource NeoText2}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="HomeCardFit" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        
        <Style x:Key="RingHitButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="24">
                            <Grid x:Name="Hover" Background="{ThemeResource NeoTrack}" CornerRadius="24" Opacity="0"/>
                            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    
        
        <Grid>
<Grid x:Name="HomeGrid" HorizontalAlignment="Stretch" RowSpacing="12" ColumnSpacing="12" SizeChanged="OnHomeGridSizeChanged">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightRailCol" Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="264"/><RowDefinition Height="*"/><RowDefinition Height="88"/><RowDefinition Height="168"/></Grid.RowDefinitions>
<Border x:Name="HeroCard" Style="{StaticResource NeoCard}" Background="#16161A" BorderBrush="#2B2B32" Padding="28"><Grid x:Name="ConnectionHeroLayout" RowSpacing="12">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
<StackPanel x:Name="ConnectionStatusLine" Orientation="Horizontal" Spacing="10"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{ThemeResource NeoText3}" VerticalAlignment="Center"/><TextBlock x:Name="RingStateText" Text="未连接" ui:AdaptiveText.BaseSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Left"/>
                                </StackPanel>
<Grid x:Name="ConnectionTimeHost" Grid.Row="2"><TextBlock x:Name="RingTimeText" Text="00:00:00" ui:AdaptiveText.BaseSize="44" Foreground="{ThemeResource NeoText1}" HorizontalAlignment="Left" FontFamily="{StaticResource NeoFont}" FontWeight="SemiBold"/>
                                
                            </Grid>
<Grid x:Name="ExitRegionRow" Grid.Row="4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="出口地区" Foreground="{ThemeResource NeoText2}" ui:AdaptiveText.BaseSize="12"/><TextBlock x:Name="ExitRegionText" Grid.Column="1" Text="—" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NeoText1}" ui:AdaptiveText.BaseSize="12"/></Grid>
<Button x:Name="RingHit" Style="{StaticResource NeoPillButton}" Grid.Row="6" Content="连接" Click="OnRingTapped" ui:AdaptiveText.BaseHeight="48" HorizontalAlignment="Stretch" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource NeoOutline}" Background="Transparent" ui:AdaptiveText.BaseSize="13" AutomationProperties.Name="连接或断开"/>
</Grid></Border>
<Border x:Name="CurrentNodeCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource NeoCard}"><Grid x:Name="CurrentNodeShell"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid x:Name="CurrentNodeLayout" RowSpacing="7" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="当前节点信息" ui:AdaptiveText.BaseSize="12.5"  Foreground="{ThemeResource NeoText2}"/>
<Grid x:Name="CurrentNodeHost" Grid.Row="1" VerticalAlignment="Center"><Grid Grid.Row="4">
                            <Border x:Name="NodePickerRow" CornerRadius="{StaticResource NeoRowRadius}" Background="Transparent" BorderThickness="0" Padding="0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="15" CornerRadius="3" Background="White" VerticalAlignment="Center" BorderBrush="#1A000000" BorderThickness="1">
                                            <Grid x:Name="SelFlag" Width="20" Height="13"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SelNodeName" Text="未选择节点" ui:AdaptiveText.BaseSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NeoText1}"/>
                                            <TextBlock x:Name="SelHint" Text="" ui:AdaptiveText.BaseSize="13" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NeoText2}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="KernelHint" Text="" ui:AdaptiveText.BaseSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NeoText3}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    
                                </Grid>
                            </Border>
                            
                            
                        </Grid>

                        
                        </Grid>
<Grid x:Name="NodeMetaHost" Grid.Row="2"><Grid Grid.Row="5" ColumnSpacing="6" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HomeMetaChip}">
                                <TextBlock x:Name="HeroLat" Text="—" ui:AdaptiveText.BaseSize="12" Foreground="{ThemeResource NeoGreen}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource HomeMetaChip}">
                                <TextBlock x:Name="HeroProto" Text="—" ui:AdaptiveText.BaseSize="12" Foreground="{ThemeResource NeoText2}"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource HomeMetaChip}">
                                <TextBlock x:Name="HeroTransport" Text="—" ui:AdaptiveText.BaseSize="12" Foreground="{ThemeResource NeoText2}"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource HomeMetaChip}" HorizontalAlignment="Left">
                                <TextBlock x:Name="HeroEndpoint" Text="—" ui:AdaptiveText.BaseSize="12" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NeoMonoFont}" Foreground="{ThemeResource NeoText2}"/>
                            </Border>
                        </Grid>
                    </Grid>
<TextBlock x:Name="RingSwitchHint" Grid.Row="3" ui:AdaptiveText.BaseSize="12" Foreground="{ThemeResource NeoAccent}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
<Grid x:Name="MultiNodeHost" Grid.Row="4"><Border Grid.Row="2" x:Name="HeroMultiBadge" Visibility="Collapsed" HorizontalAlignment="Center" CornerRadius="{StaticResource NeoPillRadius}" Padding="13,5" Background="{ThemeResource NeoAccentSoft}" BorderThickness="0">
                            <TextBlock x:Name="HeroMultiText" Text="" ui:AdaptiveText.BaseSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NeoAccent}"/>
                        </Border>

                        </Grid>

</Grid><Button x:Name="NodePickerBtn" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource NeoRowRadius}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnNodePickerClick" AutomationProperties.Name="选择节点">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent" CornerRadius="{StaticResource NeoRowRadius}">
                                            
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="PointerOver"/>
                                                    <VisualState x:Name="Pressed"/>
                                                    <VisualState x:Name="Disabled"/>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button><Grid x:Name="FloatBallRow" Grid.Row="1" Height="48"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="悬浮球" ui:AdaptiveText.BaseSize="13" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center"/><ToggleSwitch x:Name="FloatBallSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="OnFloatBallToggled" AutomationProperties.Name="悬浮球"/></Grid></Grid></Border>
<Border x:Name="TrafficCard" Grid.Row="1" Style="{StaticResource NeoCard}" Padding="18,14"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="实时流量" ui:AdaptiveText.BaseSize="12.5" Foreground="{ThemeResource NeoText2}"/>
<Grid x:Name="ChartViewport" Grid.Row="1" MinHeight="30" SizeChanged="OnChartFitSizeChanged">
 <Canvas x:Name="ChartCanvas" Background="Transparent" PointerMoved="OnChartPointerMoved" PointerExited="OnChartPointerExited">
 <Path x:Name="DownloadArea" IsHitTestVisible="False"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#225AA9FF" Offset="0"/><GradientStop Color="#005AA9FF" Offset="1"/></LinearGradientBrush></Path.Fill></Path>
 <Path x:Name="DownloadCurve" Stroke="{ThemeResource NeoAccent}" StrokeThickness="1.6" StrokeLineJoin="Round" IsHitTestVisible="False"/>
 <Path x:Name="UploadCurve" Stroke="{ThemeResource NeoYellow}" StrokeThickness="1.15" StrokeLineJoin="Round" IsHitTestVisible="False"/>
 </Canvas><Canvas x:Name="ChartTipLayer" IsHitTestVisible="False"><Border x:Name="ChartTip" Visibility="Collapsed" CornerRadius="{StaticResource NeoRowRadius}" Padding="11,8" Canvas.ZIndex="100" Background="{ThemeResource NeoSurfaceHigh}" BorderThickness="0">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="TipTime" ui:AdaptiveText.BaseSize="11.5" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TipDn" ui:AdaptiveText.BaseSize="11.5" Foreground="{ThemeResource NeoAccent}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TipUp" ui:AdaptiveText.BaseSize="11.5" Foreground="{ThemeResource NeoYellow}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            </Canvas>
</Grid>
<Grid x:Name="TrafficNumbers" Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border CornerRadius="18" Background="{ThemeResource NeoCardSurface}" Padding="10,8"><StackPanel Spacing="3"><TextBlock Text="上传" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText2}"/><StackPanel x:Name="UpNumberHost" Orientation="Horizontal" Spacing="3"><TextBlock x:Name="UpSpeedText" Text="0" ui:AdaptiveText.BaseSize="15.5" FontWeight="SemiBold"/><TextBlock x:Name="UpSpeedUnit" Text="B/s" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2"/></StackPanel></StackPanel></Border>
<Border Grid.Column="1" CornerRadius="18" Background="{ThemeResource NeoCardSurface}" Padding="10,8"><StackPanel Spacing="3"><TextBlock Text="下载" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText2}"/><StackPanel x:Name="DownNumberHost" Orientation="Horizontal" Spacing="3"><TextBlock x:Name="DownSpeedText" Text="0" ui:AdaptiveText.BaseSize="15.5" FontWeight="SemiBold"/><TextBlock x:Name="DownSpeedUnit" Text="B/s" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2"/></StackPanel></StackPanel></Border>
<Border Grid.Column="2" CornerRadius="18" Background="{ThemeResource NeoCardSurface}" Padding="10,8"><StackPanel Spacing="3"><TextBlock Text="峰值" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText2}"/><StackPanel x:Name="PeakHost" Orientation="Horizontal" Spacing="3"><TextBlock x:Name="PeakText" Text="—" ui:AdaptiveText.BaseSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PeakUnit" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2"/></StackPanel></StackPanel></Border>
</Grid></Grid></Border>
<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource NeoCard}" Padding="18,14"><Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="HealthHeadline"><TextBlock Text="连通性" ui:AdaptiveText.BaseSize="12.5" Foreground="{ThemeResource NeoText2}"/><TextBlock x:Name="NetworkHealthText" Text="连接后自动检测网络" ui:AdaptiveText.BaseSize="15" Foreground="{ThemeResource NeoText3}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                                </Grid>
<Grid x:Name="HealthCaptionHost" Grid.Row="1"><TextBlock Text="检测目标" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}"/><TextBlock HorizontalAlignment="Right" x:Name="NetworkHealthDetailText" Text="HTTPS 实测 · 检查系统代理" ui:AdaptiveText.BaseSize="10" Foreground="{ThemeResource NeoText3}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
<ScrollViewer x:Name="HomeSiteViewport" Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" ZoomMode="Disabled">
<Grid x:Name="HomeSiteGrid" VerticalAlignment="Top" ColumnSpacing="12" RowSpacing="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions></Grid>
</ScrollViewer>
<StackPanel x:Name="HealthActionHost" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="NetworkDetailsButton" Style="{StaticResource NeoPillButton}" Content="详情" Click="OnNetworkDetailsClicked" MinHeight="0" ui:AdaptiveText.BaseHeight="26" Padding="10,2" CornerRadius="13" ui:AdaptiveText.BaseSize="11"/>
                                <Button x:Name="NetworkCheckButton" Style="{StaticResource NeoPillButton}" Content="检测网络" IsEnabled="False" Click="OnCheckNetworkClicked" AutomationProperties.Name="检测网络可用性" MinHeight="0" ui:AdaptiveText.BaseHeight="26" Padding="10,2" CornerRadius="13" ui:AdaptiveText.BaseSize="11"/>
                            </StackPanel>
</Grid></Border>
<Grid x:Name="ModeHost" Grid.Row="2"><Border x:Name="ModeCard" Style="{StaticResource NeoCard}" Padding="16,10">
  <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="代理模式" Style="{StaticResource HomeCardHead}" Foreground="{ThemeResource NeoText2}"/><TextBlock Text="本地分流" Style="{StaticResource HomeCardHint}" HorizontalAlignment="Right"/></Grid>
    <Border Grid.Row="1" CornerRadius="15" Background="#47000000" Padding="3" VerticalAlignment="Center" ui:AdaptiveText.BaseHeight="32">
      <Grid x:Name="ModeSegRoot" ColumnSpacing="3" SizeChanged="OnModeSegRootSizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SegGlider" Grid.ColumnSpan="3" HorizontalAlignment="Left" CornerRadius="12" Background="#24FFFFFF"><Border.RenderTransform><TranslateTransform x:Name="SegGliderShift"/></Border.RenderTransform></Border>
        <Grid Grid.Column="0" Background="Transparent" Tapped="OnModeTapped" Tag="rule"><TextBlock x:Name="SegRuleText" Text="规则" ui:AdaptiveText.BaseSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <Grid Grid.Column="1" Background="Transparent" Tapped="OnModeTapped" Tag="global"><TextBlock x:Name="SegGlobalText" Text="全局" ui:AdaptiveText.BaseSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <Grid Grid.Column="2" Background="Transparent" Tapped="OnModeTapped" Tag="direct"><TextBlock x:Name="SegDirectText" Text="直连" ui:AdaptiveText.BaseSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Grid>
    </Border>
  </Grid>
</Border></Grid>
<Grid x:Name="TunHost" Grid.Row="2" Grid.Column="1"><Border x:Name="NetworkCard" Style="{StaticResource NeoCard}" Padding="16,10">
  <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="网络设置" Style="{StaticResource HomeCardHead}" Foreground="{ThemeResource NeoText2}"/><TextBlock x:Name="LocalProxyAddrText" Text="127.0.0.1:21808" FontFamily="{StaticResource NeoMonoFont}" Style="{StaticResource HomeCardHint}" HorizontalAlignment="Right"/></Grid>
    <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="TUN 模式" ui:AdaptiveText.BaseSize="12" FontWeight="Medium"/><TextBlock x:Name="TunModeDescription" Text="全局虚拟网卡 · 需管理员权限" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText3}" TextTrimming="CharacterEllipsis"/></StackPanel>
      <ToggleSwitch x:Name="TunSwitch" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnTunToggled"/>
    </Grid>
  </Grid>
</Border></Grid>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Neo.App.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnPageSizeChanged">

    

    <UserControl.Resources>
        <Style x:Key="HomeCardHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        </Style>
        <Style x:Key="HomeCardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HomeLineKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HomeLineVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HomeMetaChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource NeoTrack}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HomeSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText2}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        
        <Style x:Key="RingHitButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="9999">
                            <Grid x:Name="Hover" Background="{ThemeResource NeoTrack}" CornerRadius="9999"
                                  Opacity="0" />
                            <ContentPresenter x:Name="Presenter"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.6" Duration="0:0:0.06" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        
        <Grid x:Name="HomeGrid" ColumnSpacing="14" RowSpacing="14"
              SizeChanged="OnHomeGridSizeChanged">
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightRailCol" Width="372" />
            </Grid.ColumnDefinitions>

            
            <Grid Grid.Column="0" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="26,26,26,20"
                        SizeChanged="OnHeroCardSizeChanged">
                    <StackPanel>

                        

                        
                        <Grid Margin="0,4,0,4">
                        <Viewbox x:Name="RingBox" Width="236" Height="236" Stretch="Uniform" HorizontalAlignment="Center">
                        <Grid x:Name="StatusRing" Width="236" Height="236">
                            
                            <Ellipse Width="208" Height="208" Stroke="{ThemeResource NeoTrack}" StrokeThickness="9" />

                            
                            <Ellipse x:Name="RingPulse" Width="168" Height="168"
                                     Fill="{ThemeResource RingBlueSoft}" Opacity="0" />

                            
                            <Ellipse x:Name="RingFill" Width="196" Height="196"
                                     Fill="{ThemeResource RingBlueSoft}" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RingFillScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            
                            <Ellipse x:Name="RingWave1" Width="208" Height="208"
                                     Stroke="{ThemeResource RingBlue}" StrokeThickness="2" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RingWave1Scale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RingWave2" Width="208" Height="208"
                                     Stroke="{ThemeResource RingBlue}" StrokeThickness="2" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RingWave2Scale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            
                            
                            <Ellipse x:Name="RingArc" Width="208" Height="208"
                                     Stroke="{ThemeResource RingBlue}" StrokeThickness="9"
                                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                     RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="RingArcRotate" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            
                            <Ellipse x:Name="RingGlow" Width="208" Height="208"
                                     Stroke="{ThemeResource RingBlueGlow}" StrokeThickness="16"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5" />

                            

                            
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="RingStateText" Text="未连接" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="RingTimeText" Text="00:00:00" FontSize="13"
                                           Foreground="{ThemeResource NeoText2}" HorizontalAlignment="Center" />
                                
                            </StackPanel>
                        </Grid>
                        </Viewbox>
                        
                        <Button x:Name="RingHit" Style="{StaticResource RingHitButton}"
                                Width="236" Height="236" Click="OnRingTapped"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="连接 / 断开" />
                        
                        <TextBlock x:Name="RingSwitchHint" Text="" FontSize="12.5"
                                   Foreground="{ThemeResource NeoText2}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,32,0" MaxWidth="260" TextWrapping="Wrap"
                                   TextAlignment="Right" Opacity="0" IsHitTestVisible="False" />
                        </Grid>

                        
                        <Border x:Name="HeroMultiBadge" Visibility="Collapsed" HorizontalAlignment="Center"
                                CornerRadius="{StaticResource NeoPillRadius}" Padding="13,5"
                                Background="{ThemeResource NeoAccentSoft}" BorderThickness="0">
                            <TextBlock x:Name="HeroMultiText" Text="" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource NeoAccent}" />
                        </Border>

                        <Border Height="1" Background="{ThemeResource NeoHairline}" Margin="0,20,0,14" />

                        
                        <Grid>
                            <Border x:Name="NodePickerRow" CornerRadius="{StaticResource NeoRowRadius}"
                                    Background="{ThemeResource NeoTrack}" BorderThickness="0" Padding="10,8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="22" Height="15" CornerRadius="3" Background="White"
                                                BorderBrush="#1A000000" BorderThickness="1">
                                            <Grid x:Name="SelFlag" Width="20" Height="13" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SelNodeName" Text="未选择节点" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource NeoText1}" />
                                            <TextBlock x:Name="SelHint" Text="" FontSize="11.5"
                                                       Foreground="{ThemeResource NeoText3}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{ThemeResource NeoText3}" />
                                </Grid>
                            </Border>
                            
                            <Button x:Name="NodePickerBtn" Background="Transparent" BorderThickness="0"
                                    CornerRadius="{StaticResource NeoRowRadius}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Click="OnNodePickerClick" AutomationProperties.Name="选择节点">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent" CornerRadius="{StaticResource NeoRowRadius}">
                                            
                                            <Border x:Name="HoverGlow" CornerRadius="{StaticResource NeoRowRadius}"
                                                    Background="{ThemeResource NeoAccentSoft}"
                                                    BorderBrush="{ThemeResource NeoAccentLine}"
                                                    BorderThickness="1" Opacity="0" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.85" Duration="0:0:0.18" />
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1.0" Duration="0:0:0.07" />
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Disabled">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverGlow"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0" />
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,11,0,0">
                            <Border Style="{StaticResource HomeMetaChip}">
                                <TextBlock x:Name="HeroLat" Text="—" FontSize="10.5"
                                           Foreground="{ThemeResource NeoGreen}" />
                            </Border>
                            <Border Style="{StaticResource HomeMetaChip}">
                                <TextBlock x:Name="HeroProto" Text="—" FontSize="10.5"
                                           Foreground="{ThemeResource NeoText2}" />
                            </Border>
                            <Border Style="{StaticResource HomeMetaChip}">
                                <TextBlock x:Name="HeroTransport" Text="—" FontSize="10.5"
                                           Foreground="{ThemeResource NeoText2}" />
                            </Border>
                            <Border Style="{StaticResource HomeMetaChip}">
                                <TextBlock x:Name="HeroEndpoint" Text="—" FontSize="10"
                                           FontFamily="{StaticResource NeoMonoFont}"
                                           Foreground="{ThemeResource NeoText3}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                
                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource NeoCard}" Padding="18,15,18,17">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource NeoYellow}" VerticalAlignment="Center" />
                                <TextBlock Text="上传" FontSize="12" Foreground="{ThemeResource NeoText2}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,5,0,0">
                                <TextBlock x:Name="UpSpeedText" Text="0" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeoText1}" />
                                <TextBlock x:Name="UpSpeedUnit" Text="B/s" FontSize="12" FontWeight="Medium"
                                           Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource NeoCard}" Padding="18,15,18,17">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource NeoAccent}" VerticalAlignment="Center" />
                                <TextBlock Text="下载" FontSize="12" Foreground="{ThemeResource NeoText2}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,5,0,0">
                                <TextBlock x:Name="DownSpeedText" Text="0" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeoText1}" />
                                <TextBlock x:Name="DownSpeedUnit" Text="B/s" FontSize="12" FontWeight="Medium"
                                           Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                
                <Border Grid.Row="2" Style="{StaticResource NeoCard}" Padding="20,18,20,20">
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="实时流量" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="PeakText" Text="未连接" FontSize="12"
                                       Foreground="{ThemeResource NeoAccent}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        
                        <TextBlock Grid.Row="1" Text="&#x2193; 下载 · 顶格 20 MB/s" Style="{StaticResource HomeSectionLabel}"
                                   Margin="0,0,0,8" />

                        
                        <Canvas x:Name="ChartCanvas" MinHeight="238" Background="Transparent" VerticalAlignment="Stretch"
                                Grid.Row="2"
                                SizeChanged="OnChartSizeChanged"
                                PointerMoved="OnChartPointerMoved" PointerExited="OnChartPointerExited">
                            
                            <TextBlock x:Name="UpBandLabel" Text="&#x2191; 上传 · 顶格 5 MB/s" FontSize="11.5"
                                       Foreground="{ThemeResource NeoText2}" IsHitTestVisible="False"
                                       Canvas.ZIndex="200" />
                            
                            <Border x:Name="ChartTip" Visibility="Collapsed" CornerRadius="{StaticResource NeoRowRadius}"
                                    Padding="11,8" Canvas.ZIndex="100"
                                    Background="{ThemeResource NeoSurfaceHigh}" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock x:Name="TipTime" FontSize="11.5" Foreground="{ThemeResource NeoText3}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="TipDn" FontSize="11.5" Foreground="{ThemeResource NeoAccent}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="TipUp" FontSize="11.5" Foreground="{ThemeResource NeoYellow}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            
            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="20,18,20,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="&#xE753;" Style="{StaticResource Glyph}" FontSize="15"
                                           Foreground="{ThemeResource NeoAccent}" />
                                <TextBlock Text="当前订阅" Style="{StaticResource HomeCardHead}" />
                            </StackPanel>
                            <TextBlock x:Name="SubBadge" Text="未配置订阅" Style="{StaticResource HomeCardHint}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock x:Name="SubNameText" Text="未配置订阅" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource NeoText1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubUrlText" Text="—" FontSize="11" Foreground="{ThemeResource NeoText3}"
                                   Margin="0,2,0,13" TextTrimming="CharacterEllipsis" />

                        
                        <Grid Height="7" Margin="0,0,0,11">
                            <Border CornerRadius="4" Background="{ThemeResource NeoTrack}" />
                            <Grid x:Name="ConnSubBarCols">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0*" />
                                    <ColumnDefinition Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4">
                                    <Border.Background>
                                        
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{ThemeResource NeoBarFrom}" Offset="0" />
                                            <GradientStop Color="{ThemeResource NeoBarTo}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid>
                            <TextBlock x:Name="SubFlow" Text="—" Style="{StaticResource HomeLineKey}" />
                            <TextBlock x:Name="SubTotal" Text="" Style="{StaticResource HomeLineVal}" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="到期时间" Style="{StaticResource HomeLineKey}" />
                            <TextBlock x:Name="SubExpire" Text="—" Style="{StaticResource HomeLineVal}"
                                       FontFamily="{StaticResource NeoMonoFont}" />
                        </Grid>
                    </StackPanel>
                </Border>

                
                <Border Grid.Row="1" Style="{StaticResource NeoCard}" Padding="20,18,20,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="15"
                                           Foreground="{ThemeResource NeoAccent}" />
                                <TextBlock Text="代理模式" Style="{StaticResource HomeCardHead}" />
                            </StackPanel>
                            <TextBlock Text="本地分流" Style="{StaticResource HomeCardHint}" HorizontalAlignment="Right" />
                        </Grid>

                        
                        <Border CornerRadius="13" Background="{ThemeResource NeoTrack}" BorderThickness="0" Padding="3">
                            <Grid x:Name="ModeSegRoot" ColumnSpacing="3"
                                  SizeChanged="OnModeSegRootSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                
                                <Border x:Name="SegGlider" Grid.Column="0" Grid.ColumnSpan="3"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        CornerRadius="10" Background="{ThemeResource NeoAccent}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SegGliderShift" X="0" />
                                    </Border.RenderTransform>
                                </Border>

                                <Grid Grid.Column="0" Background="Transparent" Tapped="OnModeTapped" Tag="rule">
                                    <TextBlock x:Name="SegRuleText" Text="规则" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,9" />
                                </Grid>
                                <Grid Grid.Column="1" Background="Transparent" Tapped="OnModeTapped" Tag="global">
                                    <TextBlock x:Name="SegGlobalText" Text="全局" FontSize="12.5"
                                               Foreground="{ThemeResource NeoText2}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,9" />
                                </Grid>
                                <Grid Grid.Column="2" Background="Transparent" Tapped="OnModeTapped" Tag="direct">
                                    <TextBlock x:Name="SegDirectText" Text="直连" FontSize="12.5"
                                               Foreground="{ThemeResource NeoText2}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,9" />
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ModeNote" Text="规则模式：国内域名与 IP 直连，其余流量走节点；命中「广告拦截」规则时直接丢弃。"
                                   FontSize="11" Foreground="{ThemeResource NeoText3}" TextWrapping="Wrap"
                                   LineHeight="18" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                
                <Border Grid.Row="2" Style="{StaticResource NeoCard}" Padding="20,18,20,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="&#xE839;" Style="{StaticResource Glyph}" FontSize="15"
                                           Foreground="{ThemeResource NeoAccent}" />
                                <TextBlock Text="网络设置" Style="{StaticResource HomeCardHead}" />
                            </StackPanel>
                            <TextBlock x:Name="LocalProxyAddrText" Text="127.0.0.1:21808" Style="{StaticResource HomeCardHint}"
                                       FontFamily="{StaticResource NeoMonoFont}" HorizontalAlignment="Right" />
                        </Grid>

                        
                        
                        <Grid Padding="0,9" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TUN 模式" FontSize="12.5" FontWeight="Medium"
                                           Foreground="{ThemeResource NeoText1}" />
                                <TextBlock Text="全局虚拟网卡 · 需管理员权限（sing-box 接管路由）" FontSize="11"
                                           Foreground="{ThemeResource NeoText3}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TunSwitch" Grid.Column="1"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          MinWidth="0" IsOn="False" OnContent="" OffContent=""
                                          Toggled="OnTunToggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                
                <Border Grid.Row="3" Style="{StaticResource NeoCard}" Padding="20,18,20,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="CoreDot" Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{ThemeResource NeoGreen}" />
                                <TextBlock x:Name="CoreStateText" Text="内核未运行" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeoText2}" />
                            </StackPanel>
                            <Border x:Name="CoreTagBadge" HorizontalAlignment="Right" CornerRadius="7" Padding="9,3"
                                    Background="{ThemeResource NeoGreenSoft}" BorderThickness="0">
                                <TextBlock x:Name="CoreTagText" Text="—" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeoGreen}" />
                            </Border>
                        </Grid>

                        <Grid>
                            <TextBlock Text="内核版本" Style="{StaticResource HomeLineKey}" />
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                <TextBlock x:Name="CoreKindText" Text="—" Style="{StaticResource HomeLineVal}" />
                                <TextBlock x:Name="CoreVersionText" Text="" Style="{StaticResource HomeLineVal}"
                                           FontFamily="{StaticResource NeoMonoFont}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="内存占用" Style="{StaticResource HomeLineKey}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock x:Name="StatsCoreMemText" Text="—" Style="{StaticResource HomeLineVal}" />
                                <TextBlock Text="MB" FontSize="11.5" Foreground="{ThemeResource NeoText2}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="策略" Style="{StaticResource HomeLineKey}" />
                            <TextBlock x:Name="CoreStrategyText" Text="—" Style="{StaticResource HomeLineVal}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="参与节点" Style="{StaticResource HomeLineKey}" />
                            <TextBlock x:Name="CoreNodesText" Text="—" Style="{StaticResource HomeLineVal}" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource NeoHairline}" Margin="0,10,0,10" />

                        <Grid>
                            <TextBlock Text="本次上传" Style="{StaticResource HomeLineKey}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock x:Name="TotalUpText" Text="0" Style="{StaticResource HomeLineVal}" />
                                <TextBlock x:Name="TotalUpUnit" Text="B" FontSize="11.5" Foreground="{ThemeResource NeoText2}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="本次下载" Style="{StaticResource HomeLineKey}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock x:Name="TotalDownText" Text="0" Style="{StaticResource HomeLineVal}" />
                                <TextBlock x:Name="TotalDownUnit" Text="B" FontSize="11.5"
                                           Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="活跃连接" Style="{StaticResource HomeLineKey}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock x:Name="ConnCountText" Text="—" Style="{StaticResource HomeLineVal}" />
                                <TextBlock Text="条" FontSize="11.5" Foreground="{ThemeResource NeoText2}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

                                </StackPanel></Grid></Grid></Border>
<Border Grid.Row="3" Grid.Column="1" Style="{StaticResource NeoCard}" Padding="18,12"><Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="内核日志" ui:AdaptiveText.BaseSize="12.5" Foreground="{ThemeResource NeoText2}"/><Button Style="{StaticResource NeoPillButton}" Foreground="{ThemeResource NeoAccent}" Content="查看全部" Click="OnHomeLogClicked" HorizontalAlignment="Right" MinHeight="0" Padding="8,1" ui:AdaptiveText.BaseSize="10.5" BorderThickness="0" Background="Transparent" CornerRadius="13"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HomeLogRows" Spacing="4"/></ScrollViewer></Grid></Border>
</Grid>
<Grid x:Name="LegacyHomeFields" Visibility="Collapsed"><TextBlock x:Name="ModeNote" Visibility="Collapsed"/><Viewbox x:Name="RingBox" Width="160" Height="160" Stretch="Uniform" HorizontalAlignment="Center">
                        <Grid x:Name="StatusRing" ui:AdaptiveText.BaseWidth="236" Height="236">
                            
                            <Ellipse Width="208" Height="208" Stroke="{ThemeResource NeoTrack}" StrokeThickness="9"/>

                            
                            <Ellipse x:Name="RingPulse" Width="168" Height="168" Fill="{ThemeResource RingBlueSoft}" Opacity="0"/>

                            
                            <Ellipse x:Name="RingFill" Width="196" Height="196" Fill="{ThemeResource RingBlueSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RingFillScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            
                            <Ellipse x:Name="RingWave1" Width="208" Height="208" Stroke="{ThemeResource RingBlue}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RingWave1Scale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RingWave2" Width="208" Height="208" Stroke="{ThemeResource RingBlue}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="RingWave2Scale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            
                            
                            <Ellipse x:Name="RingArc" Width="208" Height="208" Stroke="{ThemeResource RingBlue}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="RingArcRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            
                            <Ellipse x:Name="RingGlow" Width="208" Height="208" Stroke="{ThemeResource RingBlueGlow}" StrokeThickness="16" Opacity="0" RenderTransformOrigin="0.5,0.5"/>

                            

                            
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                </StackPanel>
                        </Grid>
                        </Viewbox>
                        
                        
                        <Border x:Name="SubscriptionCard" Grid.Column="1" Grid.Row="0" Style="{StaticResource NeoCard}" Padding="14,10">

                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="15" Foreground="{ThemeResource NeoAccent}"/>
                                <TextBlock Text="当前订阅" Style="{StaticResource HomeCardHead}"/>
                            </StackPanel>
                            <TextBlock x:Name="SubBadge" Text="未配置订阅" Style="{StaticResource HomeCardHint}" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="SubNameText" Text="未配置订阅" ui:AdaptiveText.BaseSize="14" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubUrlText" Text="—" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}" Margin="0,2,0,5" TextTrimming="CharacterEllipsis"/>

                        
                        <Grid Height="7" Margin="0,0,0,7">
                            <Border CornerRadius="4" Background="{ThemeResource NeoTrack}"/>
                            <Grid x:Name="ConnSubBarCols">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0*"/>
                                    <ColumnDefinition Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4">
                                    <Border.Background>
                                        
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{ThemeResource NeoBarFrom}" Offset="0"/>
                                            <GradientStop Color="{ThemeResource NeoBarTo}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid>
                            <TextBlock x:Name="SubFlow" Text="—" Style="{StaticResource HomeLineKey}"/>
                            <TextBlock x:Name="SubTotal" Text="" Style="{StaticResource HomeLineVal}"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="到期时间" Style="{StaticResource HomeLineKey}"/>
                            <TextBlock x:Name="SubExpire" Text="—" Style="{StaticResource HomeLineVal}" FontFamily="{StaticResource NeoMonoFont}"/>
                        </Grid>
                    </StackPanel>

                </Border>

                
                <Grid x:Name="SpeedCards" Grid.Column="0" Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource NeoCard}" Padding="16,10">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource NeoYellow}" VerticalAlignment="Center"/>
                                <TextBlock Text="上传" ui:AdaptiveText.BaseSize="12" Foreground="{ThemeResource NeoText2}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource NeoCard}" Padding="16,10">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource NeoAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="下载" ui:AdaptiveText.BaseSize="12" Foreground="{ThemeResource NeoText2}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                
                <Image x:Name="TrafficImage" Canvas.ZIndex="10" IsHitTestVisible="False" Stretch="Fill"/>
                            
                            
                        <Ellipse x:Name="CoreDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource NeoGreen}"/>
                                <TextBlock x:Name="UpBandLabel" Grid.Column="1" Text="↑ 上传 · 顶格 5 MB/s" ui:AdaptiveText.BaseSize="11.5" Foreground="{ThemeResource NeoText2}" HorizontalAlignment="Right"/>
                        <Grid><Grid.RowDefinitions><RowDefinition x:Name="ChartPlotRow" Height="*"/>
                        </Grid.RowDefinitions></Grid></Grid>
<Canvas x:Name="ConnectionSplashLayer" IsHitTestVisible="False"/>
</Grid></UserControl>

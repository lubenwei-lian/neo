                            </StackPanel><TextBlock Text="内存占用" ui:AdaptiveText.BaseSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" Grid.Row="1"/><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"><TextBlock x:Name="StatsCoreMemText" Text="—" ui:AdaptiveText.BaseSize="11.5" FontWeight="Normal" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center"/>
                                <TextBlock Text=" MB" ui:AdaptiveText.BaseSize="11.5" Foreground="{ThemeResource NeoText2}"/></StackPanel><TextBlock Text="策略" ui:AdaptiveText.BaseSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" Grid.Row="2"/><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1"><TextBlock x:Name="CoreStrategyText" Text="—" ui:AdaptiveText.BaseSize="11.5" FontWeight="Normal" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center"/>
                        </StackPanel><TextBlock Text="参与节点" ui:AdaptiveText.BaseSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" Grid.Row="3"/><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1"><TextBlock x:Name="CoreNodesText" Text="—" ui:AdaptiveText.BaseSize="11.5" FontWeight="Normal" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center"/>

<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Neo.App.Ui" xmlns:local="using:Neo.App.Pages" x:Class="Neo.App.Pages.SubLogPage">

 <UserControl.Resources>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource NeoPillButton}"><Setter Property="CornerRadius" Value="18"/><Setter Property="ui:AdaptiveText.BaseHeight" Value="32"/><Setter Property="ui:AdaptiveText.BaseSize" Value="11.5"/><Setter Property="Padding" Value="12,0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="{ThemeResource NeoTrack}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="RowContainer" TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="22"/></Style>
 </UserControl.Resources>

 <Grid RowSpacing="16" Padding="4">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="订阅日志" ui:AdaptiveText.BaseSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <TextBlock x:Name="CountText" Grid.Column="1" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center"/>
   <Button x:Name="BtnExportLogs" Grid.Column="2" Style="{StaticResource Action}" Content="导出" Click="OnExportTxtClick"/>
   <Button Grid.Column="3" Style="{StaticResource Action}" Content="···" AutomationProperties.Name="更多日志操作"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="复制当前记录" Click="OnCopyClick"/><MenuFlyoutItem Text="导出 CSV" Click="OnExportCsvClick"/></MenuFlyout></Button.Flyout></Button>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="360"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" PlaceholderText="搜索记录" CornerRadius="18" MinWidth="100" MinHeight="0" ui:AdaptiveText.BaseHeight="36" ui:AdaptiveText.BaseSize="12" Padding="13,5,12,5" TextChanged="OnSearchChanged" AutomationProperties.Name="搜索订阅日志"/>
   <ComboBox x:Name="LevelFilter" Grid.Column="1" SelectedIndex="0" CornerRadius="18" MinWidth="134" ui:AdaptiveText.BaseHeight="36" ui:AdaptiveText.BaseSize="11.5" SelectionChanged="OnResultSelectionChanged" AutomationProperties.Name="筛选订阅日志"><ComboBoxItem Content="全部状态" Tag=""/><ComboBoxItem Content="成功" Tag="成功"/><ComboBoxItem Content="失败" Tag="失败"/><ComboBoxItem Content="进行中" Tag="进行中"/><ComboBoxItem Content="跳过" Tag="跳过"/><ComboBoxItem Content="占位" Tag="占位"/></ComboBox>
  </Grid>
  <Grid Grid.Row="2">
   <ListView x:Name="LogList" SelectionMode="None" Background="Transparent" BorderThickness="0" Padding="3,3,3,8" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource RowContainer}">
    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
    <ListView.ItemTemplate><DataTemplate x:DataType="local:SubLogRow">
     <Border CornerRadius="22" BorderBrush="{ThemeResource NeoRim}" BorderThickness="1" Background="#04FFFFFF" Padding="18,14">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{x:Bind TimeText}" ui:AdaptiveText.BaseWidth="64" ui:AdaptiveText.BaseSize="10.5" FontFamily="{StaticResource NeoMonoFont}" Foreground="{ThemeResource NeoText3}" Margin="0,3,0,0"/>
       <Border Grid.Column="1" Background="{x:Bind BadgeBackground}" CornerRadius="10" Padding="8,3" VerticalAlignment="Top"><TextBlock Text="{x:Bind LevelText}" ui:AdaptiveText.BaseSize="10.5" Foreground="{x:Bind HeadBrush}"/></Border>
       <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="{x:Bind HeadText}" ui:AdaptiveText.BaseSize="12" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="{x:Bind DetailText}" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}" TextWrapping="Wrap" Visibility="{x:Bind DetailVisibility}" IsTextSelectionEnabled="True"/></StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="EmptyHint" Text="没有匹配的记录，可更换关键词或筛选条件" ui:AdaptiveText.BaseSize="12" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="FileText" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Button Grid.Column="1" Style="{StaticResource Action}" Content="清空记录" Click="OnClearClick"/>
  </Grid>
 </Grid>
</UserControl>

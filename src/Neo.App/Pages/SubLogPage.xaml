<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Neo.App.Pages.SubLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neo.App.Pages">

    <UserControl.Resources>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText2}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GhostSm" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource NeoGlass2}" />
            <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="12,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                    <TextBlock Text="订阅日志" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" Text="共 0 条" FontSize="10.5" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock x:Name="FileText" Text="" FontSize="10.5" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{ThemeResource NeoGlass}" BorderBrush="{ThemeResource NeoGlassBorder}" BorderThickness="1" Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button x:Name="ChipAll" Style="{StaticResource ChipButton}" Tag="" Click="OnFilterClick"
                                    Content="全部" Background="{ThemeResource NeoAccent}" Foreground="White" />
                            <Button x:Name="ChipSuccess" Style="{StaticResource ChipButton}" Tag="成功" Click="OnFilterClick"
                                    Content="成功" />
                            <Button x:Name="ChipFail" Style="{StaticResource ChipButton}" Tag="失败" Click="OnFilterClick"
                                    Content="失败" />
                            <Button x:Name="ChipPlaceholder" Style="{StaticResource ChipButton}" Tag="占位" Click="OnFilterClick"
                                    Content="占位" />
                            <Button x:Name="ChipRunning" Style="{StaticResource ChipButton}" Tag="进行中" Click="OnFilterClick"
                                    Content="进行中" />
                        </StackPanel>
                    </Border>
                    <TextBox x:Name="SearchBox" Width="196" Height="30" MinHeight="0" FontSize="12" Padding="9,6.5,8,0"
                             FontFamily="{StaticResource NeoFont}" PlaceholderText="筛选订阅名或域名" TextChanged="OnSearchChanged" />
                    <Button Style="{StaticResource GhostSm}" Click="OnCopyClick">
                        <TextBlock Text="复制" FontSize="11.5" />
                    </Button>
                    <Button Style="{StaticResource GhostSm}" Click="OnClearClick">
                        <TextBlock Text="清空" FontSize="11.5" />
                    </Button>
                    <Button Style="{StaticResource GhostSm}" Click="OnExportTxtClick">
                        <TextBlock Text="导出 TXT" FontSize="11.5" />
                    </Button>
                    <Button Style="{StaticResource GhostSm}" Click="OnExportCsvClick">
                        <TextBlock Text="导出 CSV" FontSize="11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource NeoCard}" Padding="4">
            <Grid>
                <ListView x:Name="LogList"
                          SelectionMode="None"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="6,4"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SubLogRow">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind HeadText}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{x:Bind HeadBrush}" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind DetailText}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{ThemeResource NeoText3}" Visibility="{x:Bind DetailVisibility}"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHint" Text="暂无订阅日志 — 刷新订阅后会记录拉取链路"
                           FontSize="11.5" Foreground="{ThemeResource NeoText3}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

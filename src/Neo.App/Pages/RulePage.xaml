<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Neo.App.Pages.RulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="GhostSm" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource NeoGlass2}" />
            <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="12,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                    <TextBlock Text="当前模式" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeDescText" Text="国内域名与 IP 直连，其余流量走节点" FontSize="11" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center" />
                    <Border CornerRadius="5" Padding="8,2.5" Background="{ThemeResource NeoAccentSoft}" BorderBrush="{ThemeResource NeoAccentLine}" BorderThickness="1">
                        <TextBlock x:Name="ModePillText" Text="规则" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource NeoAccent}" />
                    </Border>
                    <TextBlock Text="在「连接」页切换模式" FontSize="10.5" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource NeoCard}">
            <StackPanel>
                <Grid Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                        <TextBlock Text="规则集" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                    </StackPanel>
                    <TextBlock Text="改动后自动重载内核" FontSize="10.5" Foreground="{ThemeResource NeoText2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid MinHeight="44" Padding="0,9">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="内网直连" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock Text="局域网与保留地址（geoip:private）不经过节点" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SwitchPrivate" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnPrivateToggled" />
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                <Grid MinHeight="44" Padding="0,9">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="国内直连" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock Text="命中 geosite:cn / geoip:cn 时直连，不经过节点" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SwitchCn" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnCnToggled" />
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                <Grid MinHeight="44" Padding="0,9">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="广告拦截" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock Text="命中 geosite:category-ads-all 时直接拦截" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SwitchAds" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="OnAdsToggled" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource NeoCard}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                        <TextBlock Text="自定义规则" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="5" Padding="8,2.5"
                            Background="{ThemeResource NeoAccentSoft}" BorderBrush="{ThemeResource NeoAccentLine}" BorderThickness="1">
                        <TextBlock x:Name="RuleCountText" Text="0 条" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource NeoAccent}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="RuleInput" Height="38" CornerRadius="8"
                                     Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1"
                                     FontSize="12" Padding="11,0" TextChanged="OnRuleInputChanged" />
                            <TextBlock x:Name="RuleInputHint" Text="域名或 IP，例如 example.com / 10.0.0.0/8"
                                       FontSize="12" Foreground="{ThemeResource NeoText3}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <Border Grid.Column="1" CornerRadius="9" Background="{ThemeResource NeoGlass}" BorderBrush="{ThemeResource NeoGlassBorder}" BorderThickness="1" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Grid Background="Transparent" Tapped="OnActionTapped" Tag="direct">
                                    <Border x:Name="ActDirectBg" CornerRadius="7" Background="{ThemeResource NeoAccent}" />
                                    <TextBlock x:Name="ActDirectText" Text="直连" FontSize="11" FontWeight="SemiBold" Foreground="White" Margin="10,6" />
                                </Grid>
                                <Grid Background="Transparent" Tapped="OnActionTapped" Tag="proxy">
                                    <Border x:Name="ActProxyBg" CornerRadius="7" Background="Transparent" />
                                    <TextBlock x:Name="ActProxyText" Text="代理" FontSize="11" Foreground="{ThemeResource NeoText2}" Margin="10,6" />
                                </Grid>
                                <Grid Background="Transparent" Tapped="OnActionTapped" Tag="block">
                                    <Border x:Name="ActBlockBg" CornerRadius="7" Background="Transparent" />
                                    <TextBlock x:Name="ActBlockText" Text="拦截" FontSize="11" Foreground="{ThemeResource NeoText2}" Margin="10,6" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2" Style="{StaticResource GhostSm}" Height="38" Click="OnAddRuleClick">
                            <TextBlock Text="添加" FontSize="12" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="RuleError" Text="" FontSize="10.5" Foreground="{ThemeResource NeoRed}" Visibility="Collapsed" Margin="2,0,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="RuleEmpty" Text="暂无自定义规则 — 上方输入域名或 IP 添加"
                                   FontSize="11.5" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Center" Margin="0,18,0,12" />
                        <StackPanel x:Name="RuleList" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

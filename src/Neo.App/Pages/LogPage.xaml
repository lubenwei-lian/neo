<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Neo.App.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Neo.App.Services">

    <UserControl.Resources>
        <Style x:Key="GhostSm" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource NeoGlass2}" />
            <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource NeoCard}" Padding="12,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                    <TextBlock Text="运行日志" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{ThemeResource NeoGlass}" BorderBrush="{ThemeResource NeoGlassBorder}" BorderThickness="1" Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Grid Background="Transparent" Tapped="OnLevelTapped" Tag="All">
                                <Border x:Name="ChipAllBg" CornerRadius="7" Background="{ThemeResource NeoAccent}" />
                                <TextBlock x:Name="ChipAllText" Text="全部" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Margin="10,5" />
                            </Grid>
                            <Grid Background="Transparent" Tapped="OnLevelTapped" Tag="Debug">
                                <Border x:Name="ChipDebugBg" CornerRadius="7" Background="Transparent" />
                                <TextBlock x:Name="ChipDebugText" Text="调试" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Margin="10,5" />
                            </Grid>
                            <Grid Background="Transparent" Tapped="OnLevelTapped" Tag="Info">
                                <Border x:Name="ChipInfoBg" CornerRadius="7" Background="Transparent" />
                                <TextBlock x:Name="ChipInfoText" Text="信息" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Margin="10,5" />
                            </Grid>
                            <Grid Background="Transparent" Tapped="OnLevelTapped" Tag="Warning">
                                <Border x:Name="ChipWarnBg" CornerRadius="7" Background="Transparent" />
                                <TextBlock x:Name="ChipWarnText" Text="警告" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Margin="10,5" />
                            </Grid>
                            <Grid Background="Transparent" Tapped="OnLevelTapped" Tag="Error">
                                <Border x:Name="ChipErrorBg" CornerRadius="7" Background="Transparent" />
                                <TextBlock x:Name="ChipErrorText" Text="错误" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Margin="10,5" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Background="Transparent" Tapped="OnAutoScrollTapped">
                        <Border x:Name="ChipScrollBg" CornerRadius="7" Background="{ThemeResource NeoAccent}" />
                        <TextBlock x:Name="ChipScrollText" Text="自动滚动" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Margin="10,5" />
                    </Grid>

                    <Button Style="{StaticResource GhostSm}" Click="OnClearClick">
                        <TextBlock Text="清空" FontSize="11.5" />
                    </Button>
                    <Button Style="{StaticResource GhostSm}" Click="OnOpenLogDirClick">
                        <TextBlock Text="打开日志目录" FontSize="11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource NeoCard}" Padding="4">
            <Grid>
                <ListView x:Name="LogList"
                          SelectionMode="None"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="6,4"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:LogEntry">
                            <TextBlock Text="{x:Bind Display}"
                                       FontFamily="{StaticResource NeoMonoFont}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{x:Bind LevelBrush}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHint" Text="暂无日志 — 连接后内核输出会实时显示在这里"
                           FontSize="11.5" Foreground="{ThemeResource NeoText3}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

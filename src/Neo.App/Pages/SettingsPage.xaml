<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Neo.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Neo.App.Ui">

    <UserControl.Resources>
        <Style x:Key="GhostSm" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource NeoGlass2}" />
            <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowSpacing="12" ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:CoolGlassCard Grid.Row="0" Grid.Column="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,2">
                        <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                        <TextBlock Text="通用" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                    </StackPanel>

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="开机自动启动" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="登录 Windows 后在托盘静默启动" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchAutoStart" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnAutoStartToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="启动后自动连接" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="使用上次的节点与代理模式" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchAutoConnect" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnAutoConnectToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="启动自动测速" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="启动后自动测一次全部节点延迟（后台进行）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchStartupSpeedTest" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnStartupSpeedTestToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="真实 IP 显示" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="节点卡片显示实测出口国家与 IP（打开后自动后台检测）" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchShowRealIp" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnShowRealIpToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="真连测速" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="开启后节点页测速走真实连接（慢，但能判断能不能真的访问网站）；关闭则只测到节点的 TCP 握手，更快" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchRealDelayTest" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnRealDelayTestToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="关闭窗口时最小化到托盘" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="保持代理在后台运行" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchMinTray" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnMinTrayToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="启动时最小化到托盘" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="StartMinHint" Text="开机自启时静默启动，不弹主窗口（需同时开启上面的托盘选项）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchStartMin" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnStartMinToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="界面语言" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="当前仅提供简体中文" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border
                                x:Name="LangBox"
                                Width="132"
                                Height="30"
                                CornerRadius="7"
                                Background="{ThemeResource NeoGlass2}"
                                BorderBrush="{ThemeResource NeoHairline}"
                                BorderThickness="1"
                                Padding="10,0"
                            >
                                <Grid>
                                    <TextBlock x:Name="LangText" Text="简体中文" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button
                                x:Name="LangBtn"
                                Click="OnLangTapped"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="7"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="界面语言选择"
                            />
                        </Grid>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="自动故障转移" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="当前节点连续失联时自动切换到可用节点" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchFailover" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnFailoverToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="自动修复系统代理" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="系统代理被别的程序关掉时自动恢复；如果被改成别的代理则不覆盖" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchAutoRepairProxy" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnAutoRepairProxyToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日志级别" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="LogPathHint" Text="写入 data\logs" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border x:Name="LogLevelBox" HorizontalAlignment="Right" VerticalAlignment="Center" Width="120" Height="30" CornerRadius="7" Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" Padding="10,0" Tapped="OnLogLevelTapped">
                            <Grid>
                                <TextBlock x:Name="LogLevelText" Text="警告" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日志目录" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="LogDirHint" Text="默认 data\logs" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnPickLogDir" Style="{StaticResource GhostSm}" Click="OnPickLogDirClick" ToolTipService.ToolTip="选择日志保存目录（只影响之后的新日志，旧日志不搬动）">
                                <TextBlock Text="选择" FontSize="11.5" />
                            </Button>
                            <Button x:Name="BtnResetLogDir" Style="{StaticResource GhostSm}" Click="OnResetLogDirClick" ToolTipService.ToolTip="恢复默认 data\logs">
                                <TextBlock Text="默认" FontSize="11.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日志保留" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="主日志 / 内核日志 / 订阅日志统一按此天数清理（旧日志不搬动）" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <Border x:Name="LogRetentionBox" HorizontalAlignment="Right" VerticalAlignment="Center" Width="104" Height="30" CornerRadius="7" Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" Padding="10,0" Tapped="OnLogRetentionTapped">
                            <Grid>
                                <TextBlock x:Name="LogRetentionText" Text="7 天" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid x:Name="RowCleanResidue" MinHeight="44" Padding="0,9" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="清理内核残留" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="检测到上次异常退出留下的 TUN 网卡/路由，需要管理员权限清理（清完自动消失）" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <Button x:Name="BtnCleanResidue" Style="{StaticResource GhostSm}" Click="OnCleanResidueClick" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="立即清理" FontSize="11.5" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ui:CoolGlassCard>

            <ui:CoolGlassCard Grid.Row="0" Grid.Column="1">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                            <TextBlock Text="内核" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        </StackPanel>
                        <Border
                            x:Name="KernelBadgeBg"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="5"
                            Padding="8,2.5"
                            Background="{ThemeResource NeoGreenSoft}"
                            BorderBrush="{ThemeResource NeoGreenSoft}"
                            BorderThickness="1"
                        >
                            <TextBlock x:Name="KernelBadge" Text="未运行" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource NeoGreen}" />
                        </Border>
                    </Grid>

                    
                    <StackPanel x:Name="KernelTaskPanel" Visibility="Collapsed" Margin="0,2,0,8" Spacing="6">
                        <Grid>
                            <TextBlock
                                x:Name="KernelTaskText"
                                Text="准备中…"
                                FontSize="10.5"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource NeoText2}"
                                VerticalAlignment="Center"
                                Margin="0,0,60,0"
                            />
                            <Button
                                x:Name="BtnCancelKernelTask"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource GhostSm}"
                                Click="OnCancelKernelTaskClick"
                                Content="取消"
                                FontSize="11"
                            />
                        </Grid>
                        <ProgressBar x:Name="KernelTaskBar" Minimum="0" Maximum="100" Value="0" Height="4" IsIndeterminate="True" />
                    </StackPanel>

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SOCKS5 端口" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="本地代理入口（浏览器/软件填这个）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="110"
                            Height="30"
                            CornerRadius="7"
                            Background="{ThemeResource NeoGlass2}"
                            BorderBrush="{ThemeResource NeoHairline}"
                            BorderThickness="1"
                            Padding="10,0"
                        >
                            <TextBox x:Name="PortSocksBox" Text="21808" MinWidth="0" MinHeight="0" Height="28" BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                     Padding="0,8,0,0" TextAlignment="Center" FontSize="11.5" FontFamily="{StaticResource NeoMonoFont}"
                                     Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="PortSocksBox" />
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HTTP 端口" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="本地 HTTP 代理入口" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="110"
                            Height="30"
                            CornerRadius="7"
                            Background="{ThemeResource NeoGlass2}"
                            BorderBrush="{ThemeResource NeoHairline}"
                            BorderThickness="1"
                            Padding="10,0"
                        >
                            <TextBox x:Name="PortHttpBox" Text="21809" MinWidth="0" MinHeight="0" Height="28" BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                     Padding="0,8,0,0" TextAlignment="Center" FontSize="11.5" FontFamily="{StaticResource NeoMonoFont}"
                                     Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="PortHttpBox" />
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <!-- 端口可配置：改完点「应用」会保存并自动重载内核（已连接时立即生效）。 -->
                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="应用本地端口" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="PortHintText" Text="修改后自动重载内核；默认 21808 / 21809" FontSize="10.5"
                                       TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <Button x:Name="BtnApplyPorts" Style="{StaticResource GhostSm}" Click="OnApplyPortsClick"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="BtnApplyPorts">
                            <TextBlock Text="应用" FontSize="11.5" />
                        </Button>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="xray 内核" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="XrayVersionHint" Text="本机内置内核" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border MinWidth="96" Height="30" CornerRadius="7" Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" Padding="10,0">
                                <TextBlock
                                    x:Name="XrayVersionText"
                                    Text="—"
                                    FontSize="11.5"
                                    FontFamily="{StaticResource NeoMonoFont}"
                                    Foreground="{ThemeResource NeoText1}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                />
                            </Border>
                            <Button x:Name="BtnCheckXrayUpdate" Style="{StaticResource GhostSm}" Click="OnCheckXrayUpdateClick">
                                <TextBlock Text="检查更新" FontSize="11.5" />
                            </Button>
                            <ProgressRing x:Name="RingXrayUpdate" IsActive="False" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="sing-box 内核" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="SingBoxVersionHint" Text="本机内置内核 · TUN" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border MinWidth="96" Height="30" CornerRadius="7" Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" Padding="10,0">
                                <TextBlock
                                    x:Name="SingBoxVersionText"
                                    Text="—"
                                    FontSize="11.5"
                                    FontFamily="{StaticResource NeoMonoFont}"
                                    Foreground="{ThemeResource NeoText1}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                />
                            </Border>
                            <Button x:Name="BtnCheckSingBoxUpdate" Style="{StaticResource GhostSm}" Click="OnCheckSingBoxUpdateClick">
                                <TextBlock Text="检查更新" FontSize="11.5" />
                            </Button>
                            <ProgressRing x:Name="RingSingBoxUpdate" IsActive="False" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="mihomo 内核" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="MihomoVersionHint" Text="可选内核 · 未安装（按需下载）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border MinWidth="96" Height="30" CornerRadius="7" Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" Padding="10,0">
                                <TextBlock
                                    x:Name="MihomoVersionText"
                                    Text="—"
                                    FontSize="11.5"
                                    FontFamily="{StaticResource NeoMonoFont}"
                                    Foreground="{ThemeResource NeoText1}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                />
                            </Border>
                            <Button x:Name="BtnCheckMihomoUpdate" Style="{StaticResource GhostSm}" Click="OnCheckMihomoUpdateClick">
                                <TextBlock Text="检查更新" FontSize="11.5" />
                            </Button>
                            <ProgressRing x:Name="RingMihomoUpdate" IsActive="False" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="naive 内核" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="NaiveVersionHint" Text="可选内核 · 未安装（按需下载；辅助进程）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border MinWidth="96" Height="30" CornerRadius="7" Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" Padding="10,0">
                                <TextBlock x:Name="NaiveVersionText" Text="—" FontSize="11.5" FontFamily="{StaticResource NeoMonoFont}"
                                           Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Button x:Name="BtnCheckNaiveUpdate" Style="{StaticResource GhostSm}" Click="OnCheckNaiveUpdateClick">
                                <TextBlock Text="检查更新" FontSize="11.5" />
                            </Button>
                            <ProgressRing x:Name="RingNaiveUpdate" IsActive="False" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="分流数据" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="GeoDataHint" Text="决定国内站点直连是否准确" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0"
                                       ToolTipService.ToolTip="geoip.dat / geosite.dat / Country.mmdb / sing-box rule-set。下载支持断点续传；先写临时文件再原子替换，旧文件保留为 *.bak-prev；连接中也可更新（走本地代理），被占用时下次连接前自动应用。" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnUpdateGeo" Style="{StaticResource GhostSm}" Click="OnUpdateGeoClick">
                                <TextBlock Text="更新数据" FontSize="11.5" />
                            </Button>
                            <ProgressRing x:Name="RingGeoUpdate" IsActive="False" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="检查预发布内核" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="仅对 xray 生效 · 预发布可能不稳定" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchKernelPreRelease" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnKernelPreReleaseToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <!-- 协议 → 内核手动映射（对标成熟客户端的 CoreTypeItem）：默认全自动，按能力选。 -->
                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="协议指定内核" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="CoreMapHint" Text="默认自动：按节点传输/加密能力选择内核" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <Button x:Name="BtnCoreMap" Style="{StaticResource GhostSm}" Click="OnCoreMapClick" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="配置" FontSize="11.5" />
                        </Button>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="内核异常退出后自动重启" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="关掉后内核崩溃只断开，不自动重连，等你手动处理" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchAutoRestartCore" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnAutoRestartCoreToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid x:Name="SafeModeRow" MinHeight="44" Padding="0,9" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="上次以安全模式启动" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="SafeModeHint" Text="TUN / 固定出口 已被临时关闭，可一键恢复" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <Button x:Name="BtnRestoreSafeMode" Content="恢复上次设置" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhostSm}" Click="OnRestoreSafeModeClick" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="加速方式" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock Text="固定出口：流量固定从一个节点出去，其他节点只负责帮它加速。" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                    </StackPanel>

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="固定出口（多入口加速）" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="FixedExitHint" Text="出口固定一个节点，其他节点作入口给它叠加带宽；出口仅支持 ws/tls 节点，TUN 模式下不生效，流量按两跳计" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchFixedExit" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnFixedExitToggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid x:Name="FixedExitNodeRow" MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="出口节点" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="FixedExitNodeHint" Text="自动选最快的非 REALITY 节点" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <Border
                            x:Name="FixedExitNodeBox"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="180"
                            Height="30"
                            CornerRadius="7"
                            Background="{ThemeResource NeoGlass2}"
                            BorderBrush="{ThemeResource NeoHairline}"
                            BorderThickness="1"
                            Padding="10,0"
                            Tapped="OnFixedExitNodeTapped"
                        >
                            <Grid>
                                <TextBlock x:Name="FixedExitNodeText" Text="自动" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid x:Name="FixedExitEntryRow" MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="入口数量" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="FixedExitEntryHint" Text="入口越多总带宽越高；每条连接仍只走一条链路" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                        </StackPanel>
                        <Border
                            x:Name="FixedExitEntryBox"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="120"
                            Height="30"
                            CornerRadius="7"
                            Background="{ThemeResource NeoGlass2}"
                            BorderBrush="{ThemeResource NeoHairline}"
                            BorderThickness="1"
                            Padding="10,0"
                            Tapped="OnFixedExitEntryTapped"
                        >
                            <Grid>
                                <TextBlock x:Name="FixedExitEntryText" Text="6 个" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ui:CoolGlassCard>

            <ui:CoolGlassCard Grid.Row="1" Grid.Column="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,2">
                        <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                        <TextBlock Text="外观" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                    </StackPanel>

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="紧凑布局" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="缩小行高以显示更多节点" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchCompact" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnCompactToggled" />
                    </Grid>
                </StackPanel>
            </ui:CoolGlassCard>

            <ui:CoolGlassCard Grid.Row="1" Grid.Column="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,2">
                        <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                        <TextBlock Text="关于" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                    </StackPanel>

                    <Grid Padding="0,7">
                        <TextBlock Text="版本" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Width="74" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="74,0,0,0">
                            <TextBlock x:Name="AboutVersionText" Text="neo 0.1.0" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                            <Border CornerRadius="5" Padding="6,1.5" Background="{ThemeResource NeoChipBg}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="开发版" FontSize="10" Foreground="{ThemeResource NeoText2}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Padding="0,7">
                        <TextBlock Text="构建" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Width="74" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="AboutBuildText" Text="— · win-x64" FontSize="11.5" FontFamily="{StaticResource NeoMonoFont}" Foreground="{ThemeResource NeoText1}" Margin="74,0,0,0" />
                    </Grid>

                    <Grid Padding="0,7">
                        <TextBlock Text="内核" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Width="74" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="AboutXrayText" Text="xray-core —" FontSize="11.5" FontFamily="{StaticResource NeoMonoFont}" Foreground="{ThemeResource NeoText1}" Margin="74,0,0,0" />
                    </Grid>

                    <Grid Padding="0,7">
                        <TextBlock Text="开源许可" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Width="74" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Text="MIT · 第三方组件" FontSize="11.5" Foreground="{ThemeResource NeoText1}" Margin="74,0,0,0" />
                    </Grid>

                    <Border BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="74,0,0,0">
                            
                            <Button Style="{StaticResource GhostSm}" Click="OnViewLogClick">
                                <TextBlock Text="查看日志" FontSize="11.5" />
                            </Button>
                            <Button Style="{StaticResource GhostSm}" Click="OnFeedbackClick">
                                <TextBlock Text="反馈问题" FontSize="11.5" />
                            </Button>
                            <Button Style="{StaticResource GhostSm}" Click="OnExportDiagnosticsClick"
                                    AutomationProperties.AutomationId="BtnExportDiag"
                                    ToolTipService.ToolTip="打包最近日志 + 版本信息（配置已脱敏），方便排查问题">
                                <TextBlock Text="导出诊断" FontSize="11.5" />
                            </Button>
                            <Button Style="{StaticResource GhostSm}" Click="OnExportConfigClick"
                                    AutomationProperties.AutomationId="BtnExportConfig"
                                    ToolTipService.ToolTip="把订阅/节点/规则/用量导出为 zip（不含内核与分流数据）">
                                <TextBlock Text="导出配置" FontSize="11.5" />
                            </Button>
                            <Button Style="{StaticResource GhostSm}" Click="OnImportConfigClick"
                                    AutomationProperties.AutomationId="BtnImportConfig"
                                    ToolTipService.ToolTip="从备份 zip 恢复配置（导入后重启应用）">
                                <TextBlock Text="导入配置" FontSize="11.5" />
                            </Button>
                            <Button Style="{StaticResource GhostSm}" Click="OnResetSettingsClick"
                                    AutomationProperties.AutomationId="BtnResetSettings"
                                    ToolTipService.ToolTip="恢复默认设置（保留订阅/节点/窗口位置）">
                                <TextBlock Text="恢复默认" FontSize="11.5" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:CoolGlassCard>

            <ui:CoolGlassCard Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                            <TextBlock Text="高级" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        </StackPanel>
                        <TextBlock Text="分流与 DNS · 改动后自动重载内核" FontSize="10.5" Foreground="{ThemeResource NeoText2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" MinHeight="44" Padding="0,9">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="国内地址直连" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                                <TextBlock Text="命中 geosite:cn / geoip:cn 时直连，不经过节点" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SwitchBypass" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnBypassCnToggled" />
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" MinHeight="44" Padding="0,9">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DNS 服务器" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                                <TextBlock Text="内核解析分流目标所用 DNS" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border
                                    x:Name="DnsBox"
                                    Width="158"
                                    Height="30"
                                    CornerRadius="7"
                                    Background="{ThemeResource NeoGlass2}"
                                    BorderBrush="{ThemeResource NeoHairline}"
                                    BorderThickness="1"
                                    Padding="10,0"
                                >
                                    <Grid>
                                        <TextBlock x:Name="DnsText" Text="223.5.5.5" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DnsTag" Text="· 内置" FontSize="10.5" Foreground="{ThemeResource NeoText2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Button
                                    x:Name="DnsBtn"
                                    Click="OnDnsTapped"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="7"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AutomationProperties.Name="DNS 服务器设置"
                                />
                            </Grid>
                        </Grid>

                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0">
                            <Grid MinHeight="44" Padding="0,9" Tapped="OnRuleSetTapped" Background="Transparent">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="分流规则集" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                                    <TextBlock Text="内网直连 / 国内直连 / 广告拦截" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="158"
                                    Height="30"
                                    CornerRadius="7"
                                    Background="{ThemeResource NeoGlass2}"
                                    BorderBrush="{ThemeResource NeoHairline}"
                                    BorderThickness="1"
                                    Padding="10,0"
                                >
                                    <Grid>
                                        <TextBlock x:Name="RuleSetCountText" Text="3 组已启用" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                                        <TextBlock
                                            Text=""
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="11"
                                            Foreground="{ThemeResource NeoText3}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                        />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0">
                            <Grid MinHeight="44" Padding="0,9">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="允许来自局域网的连接" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                                    <TextBlock Text="其他设备可经本机代理上网" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SwitchLan" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnAllowLanToggled" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0">
                            <Grid MinHeight="44" Padding="0,9">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="游戏直连保护" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                                    <TextBlock Text="TUN 下游戏进程流量直连不经过节点（防节点拒绝游戏 UDP）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SwitchGameDirect" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnGameDirectToggled" />
                            </Grid>
                        </Border>


                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0">
                            <Grid MinHeight="44" Padding="0,9">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="自定义游戏进程" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                                    <TextBlock x:Name="GameDirectProcSummary" Text="内置已覆盖 PUBG/CS2/L4D2/NTE 等" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="BtnEditGameProcesses" Content="编辑" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnEditGameProcessesClicked" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0">
                            <Grid MinHeight="44" Padding="0,9">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="用 Rust 生成配置（实验）" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                                    <TextBlock Text="sing-box 配置改由 Rust 生成（实验）；失败自动回退 C#（下次连接生效）" FontSize="10.5" TextWrapping="Wrap" Foreground="{ThemeResource NeoText2}" Margin="0,2,8,0" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SwitchUseRust" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" Toggled="OnUseRustToggled" />
                            </Grid>
                        </Border>

                    </Grid>
                </StackPanel>
            </ui:CoolGlassCard>

            <ui:CoolGlassCard Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                            <TextBlock Text="软件更新" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        </StackPanel>
                        <TextBlock x:Name="AppVersionText" Text="当前版本 —" FontSize="10.5" Foreground="{ThemeResource NeoText2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="检查更新" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock x:Name="UpdateStatusText" Text="从 GitHub 获取最新版本" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            
                            <ProgressRing x:Name="RingAppUpdate" IsActive="False" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center" />
                            <Button x:Name="BtnCheckAppUpdate" Style="{StaticResource GhostSm}" Click="OnCheckAppUpdateClick">
                                <TextBlock Text="立即检查" FontSize="11.5" />
                            </Button>
                            <Button x:Name="BtnDownloadUpdate" Style="{StaticResource GhostSm}" Click="OnDownloadUpdateClick" Visibility="Collapsed">
                                <TextBlock Text="下载并更新" FontSize="11.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource NeoHairline2}" />

                    <Grid MinHeight="44" Padding="0,9">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="自动检查更新" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            <TextBlock Text="启动后与运行中每 6 小时检查一次（可关闭）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="SwitchAutoCheckUpdate"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            OnContent=""
                            OffContent=""
                            Toggled="OnAutoCheckUpdateToggled"
                        />
                    </Grid>
                </StackPanel>
            </ui:CoolGlassCard>
        </Grid>
    </ScrollViewer>
</UserControl>

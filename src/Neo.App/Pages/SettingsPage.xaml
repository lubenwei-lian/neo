<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Neo.App.Ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Neo.App.Pages.SettingsPage" SizeChanged="OnSettingsSizeChanged">

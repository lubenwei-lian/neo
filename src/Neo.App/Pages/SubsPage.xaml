<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Neo.App.Pages.SubsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Neo.App.Ui">

    <UserControl.Resources>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource NeoGlass2}" />
            <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        </Style>
        <Style x:Key="GhostBtnDanger" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="{ThemeResource NeoRed}" />
        </Style>

        
        <Style x:Key="TrendCellOff" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource NeoCell}" />
            <Setter Property="CornerRadius" Value="1.5" />
        </Style>
        <Style x:Key="TrendCellOn" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource NeoCellOn}" />
            <Setter Property="CornerRadius" Value="1.5" />
        </Style>
    </UserControl.Resources>

    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:CoolGlassCard Grid.Row="0" Padding="16">
            <StackPanel x:Name="SubCardList" Spacing="0" />
        </ui:CoolGlassCard>

        
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource NeoInset}">
                <StackPanel>
                    <TextBlock Text="本周用量" FontSize="11" Foreground="{ThemeResource NeoText2}" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                        <TextBlock x:Name="WeekUsageText" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock x:Name="WeekUsageUnit" Text="B" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource NeoInset}">
                <StackPanel>
                    <TextBlock Text="本月用量" FontSize="11" Foreground="{ThemeResource NeoText2}" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                        <TextBlock x:Name="MonthUsageText" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock x:Name="MonthUsageUnit" Text="B" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource NeoInset}">
                <StackPanel>
                    <TextBlock Text="总计用量" FontSize="11" Foreground="{ThemeResource NeoText2}" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                        <TextBlock x:Name="TotalUsageText" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock x:Name="TotalUsageUnit" Text="B" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource NeoInset}">
                <StackPanel>
                    <TextBlock Text="平均延迟" FontSize="11" Foreground="{ThemeResource NeoText2}" />
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                        <TextBlock x:Name="AvgLatText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock Text="ms" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        
        <ui:CoolGlassCard Grid.Row="2" Padding="18,18,18,20">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                        <TextBlock Text="用量趋势" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnExportUsage" Style="{StaticResource GhostBtn}" Click="OnExportUsageClick"
                                AutomationProperties.AutomationId="BtnExportUsage"
                                ToolTipService.ToolTip="导出每日用量明细（CSV，最近 60 天）">
                            <TextBlock Text="导出 CSV" FontSize="11" />
                        </Button>
                        <TextBlock Text="近 30 日" FontSize="11" Foreground="{ThemeResource NeoAccent}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TrendWeekHint" Text="最近 7 天 · 顶格 20 GB/日" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Margin="0,0,0,8" />
                <Grid x:Name="TrendWeekGrid" Height="74" ColumnSpacing="2" />
                <Grid x:Name="TrendWeekLabels" Height="13" ColumnSpacing="2" Margin="0,4,0,0" />

                <TextBlock x:Name="TrendMonthHint" Text="最近 30 天 · 顶格 20 GB/日" FontSize="11.5" Foreground="{ThemeResource NeoText2}" Margin="0,16,0,8" />
                <Grid x:Name="TrendMonthGrid" Height="40" ColumnSpacing="2" />
                <Grid x:Name="TrendMonthLabels" Height="13" ColumnSpacing="2" Margin="0,4,0,0" />
            </StackPanel>
        </ui:CoolGlassCard>

        <ui:CoolGlassCard Grid.Row="3">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,4">
                    <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" />
                    <TextBlock Text="更新计划" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                </StackPanel>
                <Grid Padding="0,3">
                    <StackPanel>
                        <TextBlock Text="自动更新订阅" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock x:Name="AutoUpdateHint" Text="每 12 小时自动拉取一次（应用运行期间）" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,1,0,0" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="SwitchAutoUpdate"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        OnContent=""
                        OffContent=""
                        AutomationProperties.Name="自动更新订阅"
                        Toggled="OnAutoUpdateToggled"
                    />
                </Grid>
                <Grid Padding="0,3" Margin="0,2,0,0">
                    <StackPanel>
                        <TextBlock Text="更新间隔" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                        <TextBlock Text="自动拉取订阅的频率" FontSize="10.5" Foreground="{ThemeResource NeoText2}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border
                        x:Name="AutoUpdateIntervalBox"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="96"
                        Height="30"
                        CornerRadius="7"
                        Background="{ThemeResource NeoGlass2}"
                        BorderBrush="{ThemeResource NeoHairline}"
                        BorderThickness="1"
                        Padding="10,0"
                        Tapped="OnAutoUpdateIntervalTapped"
                    >
                        <Grid>
                            <TextBlock x:Name="AutoUpdateIntervalText" Text="12 小时" FontSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ui:CoolGlassCard>

        
        <ui:CoolGlassCard Grid.Row="4" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="" Style="{StaticResource Glyph}" FontSize="14" Foreground="{ThemeResource NeoAccent}" />
                        <TextBlock Text="地区分布" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                    </StackPanel>
                    <TextBlock x:Name="RegionSummaryText" Text="—" FontSize="10.5" Foreground="{ThemeResource NeoText2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Spacing="8">
                    <StackPanel x:Name="RegionRow1" Orientation="Horizontal" Spacing="8" />
                    <StackPanel x:Name="RegionRow2" Orientation="Horizontal" Spacing="8" />
                </StackPanel>
            </StackPanel>
        </ui:CoolGlassCard>

        <Grid x:Name="AddSubRow" Grid.Row="5" Height="64" Background="Transparent" Tapped="OnAddSubTapped">
            <Border CornerRadius="10" Background="{ThemeResource NeoGlass3}" />
            <Rectangle RadiusX="10" RadiusY="10" Stroke="{ThemeResource NeoAccentLine}" StrokeThickness="1" StrokeDashArray="5 4" />
            <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource NeoAccent}" VerticalAlignment="Center" />
                <TextBlock x:Name="AddSubTitle" Text="添加订阅" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoAccent}" VerticalAlignment="Center" />
                <TextBlock Text="支持 vmess / vless / trojan / ss 链接与 base64 订阅" FontSize="10.5" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>

<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Neo.App.Ui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Neo.App.Pages.SubsPage" SizeChanged="OnSubsSizeChanged">
    <UserControl.Resources>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource NeoPillButton}">
            <Setter Property="ui:AdaptiveText.BaseHeight" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{ThemeResource NeoGlass2}" />
            <Setter Property="BorderBrush" Value="{ThemeResource NeoHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ui:AdaptiveText.BaseSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource NeoText1}" />
        </Style>
        <Style x:Key="GhostBtnDanger" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="{ThemeResource NeoRed}" />
        </Style>
        <Style x:Key="TrendCellOff" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource NeoCell}" />
            <Setter Property="CornerRadius" Value="1.5" />
        </Style>
        <Style x:Key="TrendCellOn" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource NeoCellOn}" />
            <Setter Property="CornerRadius" Value="1.5" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid RowSpacing="9" Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="10" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="订阅" ui:AdaptiveText.BaseSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="SubCountText" Grid.Column="1" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center" />
                <Button x:Name="RefreshAllBtn" Grid.Column="2" Content="全部更新" Style="{StaticResource GhostBtn}" Click="OnRefreshAllClick" />
                <Button Grid.Column="3" Content="添加订阅" CornerRadius="18" Background="{ThemeResource NeoAccent}" Foreground="{ThemeResource NeoOnAccent}" ui:AdaptiveText.BaseSize="12" ui:AdaptiveText.BaseHeight="32" Click="OnAddSubClick" />
            </Grid>
            <StackPanel x:Name="PrimarySubHost" Grid.Row="1" />
            <Grid x:Name="TrendAndSchedule" Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:CoolGlassCard x:Name="UsageCard" Grid.Row="0" Padding="16,14" Grid.Column="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="14" Foreground="{ThemeResource NeoAccent}" />
                                <TextBlock Text="用量" ui:AdaptiveText.BaseSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TrendScaleText" Text="近 30 日" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center" />
                                <Button x:Name="BtnExportUsage" Style="{StaticResource GhostBtn}" Click="OnExportUsageClick" AutomationProperties.AutomationId="BtnExportUsage" ToolTipService.ToolTip="导出每日用量明细（CSV，最近 60 天）">
                                    <TextBlock Text="导出 CSV" ui:AdaptiveText.BaseSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,2,0,10">
                                    <TextBlock Text="本周" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}" />
                                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                                        <TextBlock x:Name="WeekUsageText" Text="0" ui:AdaptiveText.BaseSize="19" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                                        <TextBlock x:Name="WeekUsageUnit" Text="B" ui:AdaptiveText.BaseSize="11" FontWeight="Medium" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,2,0,10">
                                    <TextBlock Text="本月" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}" />
                                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                                        <TextBlock x:Name="MonthUsageText" Text="0" ui:AdaptiveText.BaseSize="19" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                                        <TextBlock x:Name="MonthUsageUnit" Text="B" ui:AdaptiveText.BaseSize="11" FontWeight="Medium" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,2,0,10">
                                    <TextBlock Text="累计" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText2}" />
                                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                                        <TextBlock x:Name="TotalUsageText" Text="0" ui:AdaptiveText.BaseSize="19" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                                        <TextBlock x:Name="TotalUsageUnit" Text="B" ui:AdaptiveText.BaseSize="11" FontWeight="Medium" Foreground="{ThemeResource NeoText2}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                </StackPanel>
                        </Grid>
                        <Grid x:Name="TrendMonthGrid" ui:AdaptiveText.BaseHeight="88" ColumnSpacing="2" SizeChanged="OnTrendSizeChanged" />
                        <Grid x:Name="TrendMonthLabels" Visibility="Collapsed" Height="16" Margin="0,5,0,0" />
                        <Grid Margin="0,9,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrendMonthHint" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText3}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="低 → 高" ui:AdaptiveText.BaseSize="10.5" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ui:CoolGlassCard>
                <ui:CoolGlassCard x:Name="ScheduleCard" Grid.Row="0" Grid.Column="1" Padding="16,14" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,4">
                            <TextBlock Text="" Style="{StaticResource Glyph}" ui:AdaptiveText.BaseSize="14" />
                            <TextBlock Text="更新计划" ui:AdaptiveText.BaseSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoText1}" />
                        </StackPanel>
                        <Grid MinHeight="50" Padding="0,5" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动更新订阅" ui:AdaptiveText.BaseSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SwitchAutoUpdate" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="自动更新订阅" Toggled="OnAutoUpdateToggled" ToolTipService.ToolTip="应用运行期间按设定间隔更新" />
                        </Grid>
                        <Grid MinHeight="50" Padding="0,5" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="更新间隔" ui:AdaptiveText.BaseSize="12.5" FontWeight="Medium" Foreground="{ThemeResource NeoText1}" />
                            </StackPanel>
                            <Border x:Name="AutoUpdateIntervalBox" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="96" ui:AdaptiveText.BaseHeight="30" CornerRadius="17" Background="{ThemeResource NeoGlass2}" BorderBrush="{ThemeResource NeoHairline}" BorderThickness="1" Padding="10,0" Tapped="OnAutoUpdateIntervalTapped">
                                <Grid>
                                    <TextBlock x:Name="AutoUpdateIntervalText" Text="12 小时" ui:AdaptiveText.BaseSize="11.5" Foreground="{ThemeResource NeoText1}" VerticalAlignment="Center" Margin="0,0,22,0" />
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid MinHeight="50" Padding="0,5" BorderBrush="{ThemeResource NeoHairline2}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="上次更新" ui:AdaptiveText.BaseSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LastSubscriptionRefresh" Grid.Column="1" ui:AdaptiveText.BaseSize="11" Foreground="{ThemeResource NeoText3}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ui:CoolGlassCard>
            </Grid>
            <Grid Grid.Row="3" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="订阅列表" ui:AdaptiveText.BaseSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RegionSummaryText" Visibility="Collapsed"/>
                    <ScrollViewer Grid.Column="1" HorizontalAlignment="Right" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="6"><StackPanel x:Name="RegionRow1" Orientation="Horizontal" Spacing="6"/><StackPanel x:Name="RegionRow2" Orientation="Horizontal" Spacing="6"/></StackPanel></ScrollViewer>
                </Grid>
            </Grid>
            <StackPanel x:Name="SubCardList" Grid.Row="4" Spacing="8" />
            <Grid x:Name="AddSubRow" Grid.Row="5" Height="48" Background="Transparent" Tapped="OnAddSubTapped">
                <Border CornerRadius="22" Background="#06FFFFFF" />
                <Rectangle RadiusX="22" RadiusY="22" Stroke="{ThemeResource NeoAccentLine}" StrokeThickness="1" StrokeDashArray="5 4" />
                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" ui:AdaptiveText.BaseSize="16" Foreground="{ThemeResource NeoAccent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="AddSubTitle" Text="添加订阅" ui:AdaptiveText.BaseSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource NeoAccent}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>CS0436;CS9113</NoWarn>
    <AppServiceSource Condition="'$(AppServiceSource)' == ''">../../src/Neo.App/Services</AppServiceSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Neo.Core/Neo.Core.csproj" />
    <Compile Include="$(AppServiceSource)/PortRelay.cs" Link="Production/PortRelay.cs" />
    <Compile Include="$(AppServiceSource)/LogBus.cs" Link="Production/LogBus.cs" />
    <Compile Include="$(BaselineRelaySource)" Link="Baseline/PortRelay.cs" Condition="'$(BaselineRelaySource)' != ''" />
  </ItemGroup>
</Project>

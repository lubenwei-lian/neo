<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TrafficChecks.cs" />
    <Compile Include="Boundaries.cs" />
    <Compile Include="../../src/Neo.Core/Presentation/TrafficChartRaster.cs" Link="Production/TrafficChartRaster.cs" />
    <Compile Include="obj/RefreshUnderTest.g.cs" />
    <Compile Include="../../src/Neo.App/Services/StatsSampler.cs" Link="Production/StatsSampler.cs" />
    <Compile Include="../../src/Neo.Core/Presentation/TrafficSampleBuffer.cs" Link="Production/TrafficSampleBuffer.cs" />
    <Compile Include="../../src/Neo.App/Services/XrayStats.cs" Link="Production/XrayStats.cs" />
  </ItemGroup>
  <Target Name="BindProductionMethods" BeforeTargets="BeforeCompile">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)prepare.py&quot; --baseline &quot;$(BaselineRoot)&quot;" />
  </Target>
  <Target Name="CopySourceBinding" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)obj/source-binding.json" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
